{
  "name": "odd-integration-tests",
  "version": "1.1.4",
  "private": true,
  "description": "Tests for the Apps-only ODD Shop and ODD Notes.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:notes": "node odd/bin/build-notes-app",
    "e2e:local": "bash bin/e2e-local.sh all",
    "e2e:docker": "docker compose -f docker-compose.e2e.yml up -d",
    "e2e:docker:down": "docker compose -f docker-compose.e2e.yml down",
    "e2e:local:provision": "bash bin/e2e-local.sh provision",
    "build:previews": "node odd/bin/build-previews",
    "catalog:preview": "odd/bin/build-catalog-preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "odd/**/*.php": [
      "vendor/bin/phpcs -q"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.59.1",
    "@wordpress/hooks": "^4.10.0",
    "esbuild": "^0.21.5",
    "husky": "^9.1.7",
    "jsdom": "^24.1.0",
    "lint-staged": "^16.4.0",
    "vitest": "^1.6.0"
  }
}
