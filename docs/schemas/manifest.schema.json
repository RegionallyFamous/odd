{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RegionallyFamous/odd/main/docs/schemas/manifest.schema.json",
  "title": "ODD app bundle manifest",
  "description": "Manifest for an Apps-only ODD .wp archive.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "name", "slug", "version", "entry", "icon"],
  "properties": {
    "$schema": {"type": "string"},
    "type": {"const": "app"},
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 64
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "author": {"type": "string", "maxLength": 120},
    "description": {"type": "string", "maxLength": 500},
    "entry": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*$"
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*\\.(?:svg|png|webp)$"
    },
    "capability": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script"],
      "properties": {
        "script": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*\\.js$"
        },
        "style": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*\\.css$"
        },
        "template": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "maxLength": 80},
        "width": {"type": "integer", "minimum": 320, "maximum": 1600},
        "height": {"type": "integer", "minimum": 240, "maximum": 1200},
        "minWidth": {"type": "integer", "minimum": 240, "maximum": 1600},
        "minHeight": {"type": "integer", "minimum": 180, "maximum": 1200},
        "min_width": {"type": "integer", "minimum": 240, "maximum": 1600},
        "min_height": {"type": "integer", "minimum": 180, "maximum": 1200},
        "resizable": {"type": "boolean"}
      }
    },
    "desktopIcon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "maxLength": 80},
        "position": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "desktop": {"type": "boolean"},
        "taskbar": {"type": "boolean"}
      }
    }
  }
}
