{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odd.regionallyfamous.com/catalog/v1/registry.schema.json",
  "title": "ODD Apps Catalog Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "generated_at",
    "bundles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "type": "string"
    },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "slug",
          "name",
          "version",
          "author",
          "description",
          "tags",
          "icon_url",
          "card_url",
          "card_bytes",
          "download_url",
          "sha256",
          "size",
          "department",
          "search_text",
          "search_tokens"
        ],
        "properties": {
          "type": {
            "const": "app"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          },
          "author": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "channel": {
            "type": "string",
            "enum": [
              "preview"
            ]
          },
          "icon_url": {
            "type": "string"
          },
          "card_url": {
            "type": "string"
          },
          "card_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "download_url": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "department": {
            "const": "apps"
          },
          "search_text": {
            "type": "string"
          },
          "search_tokens": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "api": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
              },
              "odd": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
              },
              "openStation": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
              }
            }
          }
        }
      }
    }
  }
}
