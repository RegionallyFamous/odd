#!/usr/bin/env python3
"""Validate the contents of dist/odd.zip before release."""
from __future__ import annotations

import argparse
import sys
import zipfile
from pathlib import PurePosixPath


REQUIRED = {
    "odd/odd.php",
    "odd/readme.txt",
    "odd/uninstall.php",
    "odd/languages/odd-outlandish-desktop-decorator.pot",
    "odd/includes/dependencies.php",
    "odd/includes/playground-compat.php",
    "odd/includes/enqueue.php",
    "odd/includes/content/bootstrap.php",
    "odd/includes/apps/native-surfaces.php",
    "odd/includes/notes/bootstrap.php",
    "odd/src/panel/index.js",
    "odd/src/panel/styles.css",
}

ALLOWED = {
    "odd/odd.php",
    "odd/readme.txt",
    "odd/uninstall.php",
    "odd/assets/odd-eye.svg",
    "odd/assets/odd-browser-api.js",
    "odd/data/fallback-registry.json",
    "odd/includes/dependencies.php",
    "odd/includes/playground-compat.php",
    "odd/includes/enqueue.php",
    "odd/includes/native-window.php",
    "odd/includes/apps/bootstrap.php",
    "odd/includes/apps/loader.php",
    "odd/includes/apps/native-surfaces.php",
    "odd/includes/apps/registry.php",
    "odd/includes/apps/repair.php",
    "odd/includes/apps/rest.php",
    "odd/includes/apps/serve-cookieauth.php",
    "odd/includes/apps/storage.php",
    "odd/includes/content/archive.php",
    "odd/includes/content/bootstrap.php",
    "odd/includes/content/bundle.php",
    "odd/includes/content/catalog-fallback.php",
    "odd/includes/content/catalog.php",
    "odd/includes/content/rate-limit.php",
    "odd/includes/content/reconcile.php",
    "odd/includes/content/rest.php",
    "odd/includes/notes/bootstrap.php",
    "odd/includes/notes/class-notes-rest-controller.php",
    "odd/includes/notes/class-notes-service.php",
    "odd/includes/notes/template.php",
    "odd/languages/odd-outlandish-desktop-decorator.pot",
    "odd/src/panel/index.js",
    "odd/src/panel/styles.css",
}

FORBIDDEN_SOURCE_TOKENS = {
    "wp.desktop",
    "desktopModeNativeWindows",
    "wpDesktopNativeWindows",
    "desktop_mode_register_window",
    "desktop_mode_register_icon",
    "desktop_mode_shell_config",
    "oddout_apps_apply_manifest_extensions",
    "odd-app-runtime",
    "oddout_scene_registry",
    "oddout_widget_registry",
    "oddout_icons_get_sets",
    "oddout_cursors_get_sets",
}

FORBIDDEN_PARTS = {
    ".cursor",
    ".git",
    ".github",
    "__pycache__",
    "_tools",
    "ci",
    "dist",
    "node_modules",
    "tests",
    "vendor",
}

FORBIDDEN_NAMES = {
    ".DS_Store",
    ".env",
    ".env.local",
    ".gitignore",
    ".gitkeep",
    "composer.json",
    "composer.lock",
    "package.json",
    "package-lock.json",
    "phpcs.xml.dist",
}

FORBIDDEN_SUFFIXES = {
    ".bak",
    ".log",
    ".map",
    ".plan.md",
    ".py",
    ".pyc",
    ".tmp",
}


def main() -> int:
    parser = argparse.ArgumentParser(description="Check ODD release zip contents.")
    parser.add_argument("zipfile", nargs="?", default="dist/odd.zip")
    parser.add_argument("--list", action="store_true", help="print archive contents")
    args = parser.parse_args()

    try:
        with zipfile.ZipFile(args.zipfile) as zf:
            names = sorted(name for name in zf.namelist() if not name.endswith("/"))
            source_violations: list[str] = []
            for name in names:
                if PurePosixPath(name).suffix.lower() not in {".php", ".js", ".json", ".css"}:
                    continue
                text = zf.read(name).decode("utf-8", errors="replace")
                for token in FORBIDDEN_SOURCE_TOKENS:
                    if token in text:
                        source_violations.append(f"{name}: {token}")
    except FileNotFoundError:
        print(f"error: missing {args.zipfile}", file=sys.stderr)
        return 1
    except zipfile.BadZipFile:
        print(f"error: {args.zipfile} is not a valid zip", file=sys.stderr)
        return 1

    if args.list:
        for name in names:
            print(name)

    missing = sorted(REQUIRED.difference(names))
    if missing:
        print("error: release zip is missing required files:", file=sys.stderr)
        for name in missing:
            print(f"  {name}", file=sys.stderr)
        return 1

    unexpected = sorted(set(names).difference(ALLOWED))
    if unexpected:
        print("error: release zip contains files outside the Apps-only allowlist:", file=sys.stderr)
        for name in unexpected:
            print(f"  {name}", file=sys.stderr)
        return 1

    if source_violations:
        print("error: release zip contains unsupported API/runtime tokens:", file=sys.stderr)
        for violation in source_violations:
            print(f"  {violation}", file=sys.stderr)
        return 1

    forbidden: list[str] = []
    for name in names:
        path = PurePosixPath(name)
        if path.parts[0] != "odd":
            forbidden.append(f"{name} (not under odd/)")
            continue
        if any(part in FORBIDDEN_PARTS for part in path.parts):
            forbidden.append(name)
            continue
        if path.name.startswith("."):
            forbidden.append(name)
            continue
        if path.name in FORBIDDEN_NAMES:
            forbidden.append(name)
            continue
        if any(path.name.endswith(suffix) for suffix in FORBIDDEN_SUFFIXES):
            forbidden.append(name)

    if forbidden:
        print("error: release zip contains forbidden files:", file=sys.stderr)
        for name in forbidden:
            print(f"  {name}", file=sys.stderr)
        return 1

    print(f"OK: {args.zipfile} contains {len(names)} release files and no forbidden paths")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
