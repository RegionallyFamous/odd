#!/usr/bin/env python3
"""Validate an Apps-only ODD .wp manifest against the published JSON
Schema at `docs/schemas/manifest.schema.json`.

Usage:
  odd/bin/validate-manifest path/to/manifest.json [...more]

Exits non-zero when any manifest fails the schema. Intended for
app authors (we ship this with the repo so vendors can
run it without pulling in a JavaScript toolchain) and for the CI
matrix check in .github/workflows/ci.yml.

The schema is the source of truth for manifest shape. The PHP archive
validator additionally asserts file presence, paths, size, compression,
and executable-file restrictions.

Dependencies:
  - Python 3.9+
  - `jsonschema` from `requirements-catalog.txt`. Validation never
    silently downgrades to a partial structural check.
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO_ROOT = HERE.parent.parent
sys.path.insert(0, str(REPO_ROOT / "_tools"))

try:
    from manifest_validation import validate_manifest
except ImportError as exc:
    print(
        "Manifest validation dependencies are unavailable. Install the pinned "
        "catalog dependencies with `python -m pip install -r "
        f"requirements-catalog.txt` ({exc}).",
        file=sys.stderr,
    )
    sys.exit(2)


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: validate-manifest path/to/manifest.json [...]", file=sys.stderr)
        return 2

    any_failed = False
    for path_str in sys.argv[1:]:
        path = Path(path_str)
        if not path.exists():
            print(f"[FAIL] {path}: not found", file=sys.stderr)
            any_failed = True
            continue
        try:
            manifest = json.loads(path.read_text())
        except json.JSONDecodeError as e:
            print(f"[FAIL] {path}: invalid JSON ({e})", file=sys.stderr)
            any_failed = True
            continue

        problems = validate_manifest(manifest)

        if problems:
            any_failed = True
            print(f"[FAIL] {path}")
            for p in problems:
                print(f"  - {p}")
        else:
            print(f"[ok]   {path}")

    return 1 if any_failed else 0


if __name__ == "__main__":
    sys.exit(main())
