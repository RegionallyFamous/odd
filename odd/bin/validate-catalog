#!/usr/bin/env python3
"""Validate the deterministic, Apps-only ODD catalog."""

from __future__ import annotations

import base64
import hashlib
import io
import json
import os
import re
import subprocess
import sys
import xml.etree.ElementTree as ET
import zipfile
from pathlib import Path
from urllib.parse import urlparse

from PIL import Image


HERE = Path(__file__).resolve().parent
REPO = HERE.parent.parent


def repo_path_from_env(name: str, default: Path) -> Path:
    raw = (os.environ.get(name) or "").strip()
    if not raw:
        return default
    path = Path(raw)
    return path if path.is_absolute() else REPO / path


CATALOG = repo_path_from_env("ODD_CATALOG_OUT_ROOT", REPO / "site" / "catalog" / "v1")
REGISTRY = CATALOG / "registry.json"
SIGNATURE = CATALOG / "registry.json.sig"
SCHEMA = CATALOG / "registry.schema.json"
FALLBACK = repo_path_from_env(
    "ODD_CATALOG_FALLBACK_REGISTRY", REPO / "odd" / "data" / "fallback-registry.json"
)
VALIDATE_FALLBACK = os.environ.get("ODD_VALIDATE_FALLBACK_REGISTRY", "1") != "0"
BASE_URL = (
    os.environ.get("ODD_CATALOG_BASE_URL")
    or "https://odd.regionallyfamous.com/catalog/v1"
).rstrip("/") + "/"
PUBLIC_KEY = "2aIvGPQMF//a9ciDvQ8GST7Q8QhfVsM6h1HB3/Td5Gk="
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
SEMVER_RE = re.compile(
    r"^[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$"
)
PATH_RE = re.compile(r"^[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*$")
FORBIDDEN_EXTENSIONS = {
    "bash", "cgi", "phar", "php", "php3", "php4", "php5", "php7",
    "phps", "phtml", "pl", "py", "rb", "sh",
}
MANIFEST_KEYS = {
    "$schema", "author", "capability", "description", "desktopIcon",
    "entry", "icon", "name", "native", "slug", "surfaces", "type", "version",
    "window",
}
REQUIRES_KEYS = {"odd", "openStation", "api"}
CARD_SIZE = (1024, 576)
MAX_CARD_BYTES = 320 * 1024
MAX_ICON_BYTES = 768 * 1024
MAX_FILES = 2000
MAX_UNCOMPRESSED = 25 * 1024 * 1024


def display(path: Path) -> str:
    try:
        return str(path.relative_to(REPO))
    except ValueError:
        return str(path)


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def resolve_url(url: object) -> Path | None:
    if not isinstance(url, str):
        return None
    if url.startswith(BASE_URL):
        path = CATALOG / url[len(BASE_URL):]
        try:
            path.resolve().relative_to(CATALOG.resolve())
        except ValueError:
            return None
        return path
    parsed = urlparse(url)
    if parsed.scheme in {"", "file"}:
        return Path(url)
    return None


def validate_signature(problems: list[str]) -> None:
    required = os.environ.get("ODD_VALIDATE_REQUIRE_CATALOG_SIGNATURE") == "1"
    if not required and not SIGNATURE.is_file():
        return
    if not SIGNATURE.is_file():
        problems.append("registry.json.sig is missing")
        return
    try:
        key = base64.b64decode(os.environ.get("ODD_CATALOG_PUBLIC_KEY", PUBLIC_KEY), validate=True)
        signature = base64.b64decode(SIGNATURE.read_text().strip(), validate=True)
        from nacl.signing import VerifyKey
        VerifyKey(key).verify(REGISTRY.read_bytes(), signature)
    except Exception as exc:
        problems.append(f"catalog signature verification failed: {exc}")


def validate_schema(data: dict, problems: list[str]) -> None:
    if not SCHEMA.is_file():
        problems.append("registry.schema.json is missing")
        return
    try:
        schema = json.loads(SCHEMA.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        problems.append(f"registry.schema.json is invalid: {exc}")
        return
    try:
        from jsonschema import Draft7Validator
    except ImportError:
        if os.environ.get("ODD_REQUIRE_JSONSCHEMA") == "1":
            problems.append("jsonschema is required for catalog validation")
        return
    for error in sorted(Draft7Validator(schema).iter_errors(data), key=lambda item: list(item.path)):
        location = "/".join(str(part) for part in error.absolute_path) or "(root)"
        problems.append(f"registry schema {location}: {error.message}")


def validate_svg(data: bytes, label: str, problems: list[str]) -> None:
    try:
        root = ET.fromstring(data.decode("utf-8"))
    except (UnicodeDecodeError, ET.ParseError) as exc:
        problems.append(f"{label}: invalid SVG ({exc})")
        return
    if root.tag.split("}")[-1] != "svg" or not root.attrib.get("viewBox"):
        problems.append(f"{label}: SVG must have an svg root and viewBox")
    text = data.decode("utf-8", errors="replace")
    if re.search(r"<script\b|\bon[a-z]+\s*=|(?:javascript|data|vbscript)\s*:", text, re.I):
        problems.append(f"{label}: SVG contains scriptable content")


def validate_icon(path: Path, label: str, problems: list[str]) -> None:
    if not path.is_file():
        problems.append(f"{label}: icon file is missing")
        return
    data = path.read_bytes()
    if len(data) > MAX_ICON_BYTES:
        problems.append(f"{label}: icon exceeds {MAX_ICON_BYTES} bytes")
        return
    if path.suffix.lower() == ".svg":
        validate_svg(data, label, problems)
        return
    expected = {".png": "PNG", ".webp": "WEBP"}.get(path.suffix.lower())
    if expected is None:
        problems.append(f"{label}: icon must be SVG, PNG, or WebP")
        return
    try:
        with Image.open(io.BytesIO(data)) as image:
            image.verify()
        with Image.open(io.BytesIO(data)) as image:
            if image.format != expected or image.width != image.height:
                problems.append(f"{label}: raster icon format or dimensions are invalid")
            if not 64 <= image.width <= 2048:
                problems.append(f"{label}: raster icon dimensions are outside 64-2048px")
            alpha = image.convert("RGBA").getchannel("A")
            width, height = image.size
            edge = [alpha.getpixel((x, y)) for x in range(width) for y in (0, height - 1)]
            edge += [alpha.getpixel((x, y)) for y in range(height) for x in (0, width - 1)]
            if sum(value < 32 for value in edge) / len(edge) < 0.90:
                problems.append(f"{label}: app icon needs transparent edges")
    except (OSError, SyntaxError) as exc:
        problems.append(f"{label}: invalid raster icon ({exc})")


def validate_html(entry: str, html: str, names: set[str], label: str, problems: list[str]) -> None:
    if re.search(r"<base\b", html, re.I):
        problems.append(f"{label}: HTML entry contains a base tag")
    for reference in re.findall(r"(?:src|href)\s*=\s*['\"]([^'\"]+)['\"]", html, re.I):
        if reference.startswith(("data:", "#")):
            continue
        if reference.startswith(("http://", "https://", "//", "/")):
            problems.append(f"{label}: HTML entry contains non-local asset {reference!r}")
            continue
        clean = reference.split("?", 1)[0].split("#", 1)[0]
        parts = [part for part in clean.split("/") if part not in {"", "."}]
        if ".." in parts or "/".join(parts) not in names:
            problems.append(f"{label}: HTML entry references missing asset {reference!r}")


def validate_bundle(path: Path, row: dict, label: str, problems: list[str]) -> None:
    try:
        with zipfile.ZipFile(path) as archive:
            names = archive.namelist()
            if len(names) > MAX_FILES:
                problems.append(f"{label}: archive exceeds {MAX_FILES} entries")
            total = 0
            for info in archive.infolist():
                name = info.filename
                total += info.file_size
                if not PATH_RE.fullmatch(name) or ".." in Path(name).parts:
                    problems.append(f"{label}: unsafe archive path {name!r}")
                if Path(name).suffix.lower().lstrip(".") in FORBIDDEN_EXTENSIONS:
                    problems.append(f"{label}: server-executable archive entry {name!r}")
                mode = (info.external_attr >> 16) & 0o170000
                if mode == 0o120000:
                    problems.append(f"{label}: archive contains symlink {name!r}")
                if info.compress_size and info.file_size / info.compress_size > 100:
                    problems.append(f"{label}: suspicious compression ratio in {name!r}")
                if Path(name).suffix.lower() in {".js", ".mjs"}:
                    source = archive.read(name).decode("utf-8", errors="replace")
                    if re.search(r"\b(?:navigator\.)?serviceWorker\b", source):
                        problems.append(f"{label}: service-worker code in {name!r}")
                    bare = re.search(
                        r"\b(?:from\s*|import\s*)(?:\([^)]*)?['\"](?![./]|https?://)([^'\"]+)['\"]",
                        source,
                    )
                    if bare:
                        problems.append(f"{label}: unresolved module import {bare.group(1)!r} in {name!r}")
            if total > MAX_UNCOMPRESSED:
                problems.append(f"{label}: archive exceeds {MAX_UNCOMPRESSED} uncompressed bytes")
            if "manifest.json" not in names:
                problems.append(f"{label}: manifest.json is missing")
                return
            try:
                manifest = json.loads(archive.read("manifest.json"))
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                problems.append(f"{label}: manifest.json is invalid ({exc})")
                return
            if not isinstance(manifest, dict):
                problems.append(f"{label}: manifest.json must be an object")
                return
            unknown = set(manifest).difference(MANIFEST_KEYS)
            if unknown:
                problems.append(f"{label}: manifest has unsupported keys {sorted(unknown)}")
            if manifest.get("type") != "app":
                problems.append(f"{label}: manifest type must be app")
            if manifest.get("slug") != row.get("slug"):
                problems.append(f"{label}: manifest slug does not match registry")
            if manifest.get("version") != row.get("version"):
                problems.append(f"{label}: manifest version does not match registry")
            for field in ("entry", "icon"):
                value = manifest.get(field)
                if not isinstance(value, str) or value not in names or not PATH_RE.fullmatch(value):
                    problems.append(f"{label}: manifest {field} is missing or unsafe")
            icon = manifest.get("icon")
            if isinstance(icon, str) and icon in names:
                temp_icon = CATALOG / ".validate-icon" / Path(icon).name
                temp_icon.parent.mkdir(exist_ok=True)
                temp_icon.write_bytes(archive.read(icon))
                validate_icon(temp_icon, f"{label} manifest icon", problems)
                temp_icon.unlink(missing_ok=True)
                temp_icon.parent.rmdir()
            entry = manifest.get("entry")
            if isinstance(entry, str) and entry in names and Path(entry).suffix.lower() in {".html", ".htm"}:
                validate_html(
                    entry,
                    archive.read(entry).decode("utf-8", errors="replace"),
                    set(names),
                    label,
                    problems,
                )
    except zipfile.BadZipFile:
        problems.append(f"{label}: bundle is not a valid ZIP")


def validate_row(row: dict, index: int, seen: set[str], problems: list[str]) -> None:
    label = f"bundle[{index}]"
    required = {
        "type", "slug", "name", "version", "author", "description", "tags",
        "icon_url", "card_url", "card_bytes", "download_url", "sha256", "size",
        "department", "search_text", "search_tokens",
    }
    missing = required.difference(row)
    if missing:
        problems.append(f"{label}: missing registry keys {sorted(missing)}")
        return
    slug = row.get("slug")
    label = f"bundle[{index}] ({slug})"
    if row.get("type") != "app" or row.get("department") != "apps":
        problems.append(f"{label}: catalog is Apps-only")
    if not isinstance(slug, str) or not SLUG_RE.fullmatch(slug):
        problems.append(f"{label}: invalid slug")
    elif slug in seen:
        problems.append(f"{label}: duplicate slug")
    else:
        seen.add(slug)
    version = row.get("version")
    if not isinstance(version, str) or not SEMVER_RE.fullmatch(version):
        problems.append(f"{label}: invalid version")
    requires = row.get("requires", {})
    if not isinstance(requires, dict) or set(requires).difference(REQUIRES_KEYS):
        problems.append(f"{label}: invalid requires object")
    elif any(not isinstance(value, str) or not SEMVER_RE.fullmatch(value) for value in requires.values()):
        problems.append(f"{label}: invalid requires version")
    bundle = resolve_url(row.get("download_url"))
    icon = resolve_url(row.get("icon_url"))
    card = resolve_url(row.get("card_url"))
    if bundle is None or not bundle.is_file():
        problems.append(f"{label}: download_url does not resolve")
        return
    if row.get("size") != bundle.stat().st_size:
        problems.append(f"{label}: size does not match bundle")
    if row.get("sha256") != digest(bundle):
        problems.append(f"{label}: sha256 does not match bundle")
    if icon is None:
        problems.append(f"{label}: icon_url does not resolve")
    else:
        validate_icon(icon, f"{label} catalog icon", problems)
    if card is None or not card.is_file():
        problems.append(f"{label}: card_url does not resolve")
    else:
        if card.stat().st_size > MAX_CARD_BYTES or row.get("card_bytes") != card.stat().st_size:
            problems.append(f"{label}: card byte budget or card_bytes mismatch")
        try:
            with Image.open(card) as image:
                if image.format != "WEBP" or image.size != CARD_SIZE:
                    problems.append(f"{label}: card must be a 1024x576 WebP")
        except (OSError, SyntaxError) as exc:
            problems.append(f"{label}: invalid card ({exc})")
    validate_bundle(bundle, row, label, problems)


def artifact_paths() -> list[Path]:
    paths = list((CATALOG / "bundles").glob("*.wp"))
    paths += list((CATALOG / "icons").glob("*"))
    paths += list((CATALOG / "cards").glob("*"))
    paths += [REGISTRY, SCHEMA]
    if VALIDATE_FALLBACK:
        paths.append(FALLBACK)
    if SIGNATURE.is_file():
        paths.append(SIGNATURE)
    return sorted(path for path in paths if path.is_file())


def validate_determinism(problems: list[str]) -> None:
    if os.environ.get("ODD_VALIDATE_REBUILD") != "1":
        return
    before = {path: digest(path) for path in artifact_paths()}
    result = subprocess.run(
        [sys.executable, str(REPO / "_tools" / "build-catalog.py")],
        capture_output=True,
        check=False,
    )
    if result.returncode:
        problems.append(f"catalog rebuild failed: {result.stderr.decode(errors='replace')}")
        return
    after = {path: digest(path) for path in artifact_paths()}
    if before.keys() != after.keys():
        problems.append("catalog rebuild changed the artifact file set")
    for path in before.keys() & after.keys():
        if before[path] != after[path]:
            problems.append(f"catalog rebuild changed {display(path)}")


def main() -> int:
    problems: list[str] = []
    if not REGISTRY.is_file():
        print(f"error: {display(REGISTRY)} is missing", file=sys.stderr)
        return 1
    try:
        data = json.loads(REGISTRY.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        print(f"error: registry.json is invalid: {exc}", file=sys.stderr)
        return 1
    if not isinstance(data, dict):
        print("error: registry.json must be an object", file=sys.stderr)
        return 1
    if set(data) != {"$schema", "version", "generated_at", "bundles"}:
        problems.append("registry contains unsupported top-level keys")
    if data.get("version") != 1 or not isinstance(data.get("bundles"), list):
        problems.append("registry version or bundles shape is invalid")
    validate_signature(problems)
    validate_schema(data, problems)
    seen: set[str] = set()
    for index, row in enumerate(data.get("bundles", [])):
        if not isinstance(row, dict):
            problems.append(f"bundle[{index}] must be an object")
            continue
        validate_row(row, index, seen, problems)
    if VALIDATE_FALLBACK:
        if not FALLBACK.is_file() or FALLBACK.read_bytes() != REGISTRY.read_bytes():
            problems.append("fallback registry is missing or differs from registry.json")
    validate_determinism(problems)
    if problems:
        print("catalog validation failed:", file=sys.stderr)
        for problem in problems:
            print(f"  - {problem}", file=sys.stderr)
        return 1
    print(f"catalog ok: {len(seen)} app bundles")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
