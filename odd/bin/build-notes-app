#!/usr/bin/env node

import { build } from 'esbuild';
import { readFile, writeFile } from 'node:fs/promises';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const scriptDir = dirname( fileURLToPath( import.meta.url ) );
const repoRoot = resolve( scriptDir, '../..' );
const appRoot = resolve( repoRoot, '_tools/catalog-sources/apps/odd-notes' );
const entry = resolve( appRoot, 'src/index.ts' );
const vendorPath = resolve( appRoot, 'component-snapshot/openstation-ui-components.min.js' );
const outputPath = resolve( appRoot, 'bundle-src/assets/js/odd-notes.min.js' );

const [ vendor, runtime ] = await Promise.all( [
	readFile( vendorPath, 'utf8' ),
	build( {
		entryPoints: [ entry ],
		bundle: true,
		format: 'iife',
		legalComments: 'none',
		minify: true,
		platform: 'browser',
		target: [ 'es2020' ],
		write: false,
	} ),
] );

if ( ! vendor.includes( '"os-textarea"' ) || ! vendor.includes( '"os-tag-input"' ) ) {
	throw new Error( 'The vendored OpenStation component snapshot is incomplete.' );
}
if ( runtime.outputFiles.length !== 1 ) {
	throw new Error( 'Expected one compiled ODD Notes runtime.' );
}

const output = `${ vendor.trimEnd() }\n${ runtime.outputFiles[ 0 ].text.trim() }\n`;
await writeFile( outputPath, output );
console.log( `built ${ outputPath.replace( `${ repoRoot }/`, '' ) } (${ output.length.toLocaleString() } bytes)` );
