#!/usr/bin/env python3
"""Build dist/odd.zip from odd/ at the repo root.

Ships an explicit Apps-only runtime allowlist. Fails if the resulting zip
exceeds MAX_ZIP_BYTES so a silent payload-doubling regression cannot ship.

The archive's inner directory is `odd/` so it unpacks directly into
`wp-content/plugins/odd/`.

Usage:
    odd/bin/build-zip [--max-bytes N]
"""
from __future__ import annotations

import argparse
import sys
import zipfile
from pathlib import Path


HERE = Path(__file__).resolve().parent
PLUGIN_DIR = HERE.parent
REPO_ROOT = PLUGIN_DIR.parent
DIST = REPO_ROOT / "dist"
ZIP_NAME = "odd.zip"

# 2 MB budget. ODD Notes installs on demand from the remote app catalog.
DEFAULT_MAX_BYTES = 2 * 1024 * 1024

LIVE_FILES = {
    "odd.php",
    "readme.txt",
    "uninstall.php",
    "assets/odd-eye.svg",
    "data/fallback-registry.json",
    "includes/dependencies.php",
    "includes/enqueue.php",
    "includes/native-window.php",
    "includes/apps/bootstrap.php",
    "includes/apps/loader.php",
    "includes/apps/native-surfaces.php",
    "includes/apps/registry.php",
    "includes/apps/repair.php",
    "includes/apps/rest.php",
    "includes/apps/serve-cookieauth.php",
    "includes/apps/storage.php",
    "includes/content/archive.php",
    "includes/content/bootstrap.php",
    "includes/content/bundle.php",
    "includes/content/catalog-fallback.php",
    "includes/content/catalog.php",
    "includes/content/rate-limit.php",
    "includes/content/reconcile.php",
    "includes/content/rest.php",
    "includes/notes/bootstrap.php",
    "includes/notes/class-notes-rest-controller.php",
    "includes/notes/class-notes-service.php",
    "includes/notes/template.php",
    "src/panel/index.js",
    "src/panel/styles.css",
}


def should_include(rel: Path) -> bool:
    value = rel.as_posix()
    return value in LIVE_FILES or value.startswith("languages/")


def main() -> int:
    parser = argparse.ArgumentParser(description="Build the ODD release zip.")
    parser.add_argument(
        "--max-bytes",
        type=int,
        default=DEFAULT_MAX_BYTES,
        help=f"fail if the zip exceeds this many bytes (default {DEFAULT_MAX_BYTES})",
    )
    args = parser.parse_args()

    DIST.mkdir(parents=True, exist_ok=True)
    out = DIST / ZIP_NAME
    if out.exists():
        out.unlink()

    count = 0
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as zf:
        for path in sorted(PLUGIN_DIR.rglob("*")):
            if not path.is_file():
                continue
            rel = path.relative_to(PLUGIN_DIR)
            if not should_include(rel):
                continue
            arcname = Path("odd") / rel
            zf.write(path, arcname=str(arcname))
            count += 1

    size = out.stat().st_size
    pct = (size / args.max_bytes) * 100
    print(f"  wrote {out.relative_to(REPO_ROOT)}  ({count} files, {size:,} bytes, {pct:.1f}% of budget)")

    if size > args.max_bytes:
        print(
            f"error: zip size {size:,} exceeds budget {args.max_bytes:,} bytes",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
