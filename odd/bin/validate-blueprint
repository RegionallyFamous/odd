#!/usr/bin/env python3
"""Validate ODD's public Playground blueprint for reliability regressions.

Background
----------
`blueprint.json` at the repo root and `site/playground/blueprint.json`
are the source and hosted forms of the public Playground demo. The pair
`blueprint-dev.json` / `site/playground/blueprint-dev.json` installs the
pinned current OpenStation release from WordPress.org plus ODD **main** for
throwaway trunk tests.
The preview pair `blueprint-preview.json` /
`site/playground/blueprint-preview.json` uses the same trunk plugin install
but routes ODD to the non-live hosted preview catalog at
`/catalog-preview/v1/`.
Any step that depends on a
browser-blocked URL, a wiggly `releases/latest/download` redirect, or
an unexpected source install can turn the first-run experience into a
CORS failure — and that's typically the first thing a new user ever sees.

This script parses the blueprint and fails on known-fragile patterns so
regressions are caught before they reach `main`.

The public blueprints intentionally install both OpenStation and ODD from
exact versioned WordPress.org release zip URLs. The stable OpenStation pin is
read from the root public blueprint so the already-released WP.org pair can
remain stable while trunk moves to a newer host API.
During release prep, the public ODD zip may intentionally lag behind
`ODDOUT_VERSION` until the matching WordPress.org SVN tag exists.
The dev blueprints stay deterministic: OpenStation is pinned with
`resource: "url"` to
`https://downloads.wordpress.org/plugin/desktop-mode.{version}.zip` where
`{version}` equals `ODDOUT_OPENSTATION_MIN_VERSION`, while ODD comes from
`main`.

Release blueprint pins must agree with values in `odd/odd.php` (checklist #8).

Checks (all emit bullets; any failure → exit code 1):

  1. All six JSON files exist and parse (`blueprint.json`,
     `blueprint-dev.json`, `blueprint-preview.json`, and each mirrored
     under `site/playground/`).
  2. No `installPlugin` step uses GitHub release asset URLs.
     GitHub serves release assets without Playground-compatible CORS
     headers, even when the tag is pinned.
  3. Every `git:directory` installPlugin resource has:
        - `ref`   (tag / branch / SHA)
        - `refType` (one of `tag`, `branch`, `commit`, `refname`)
        - `path`  (use `/` for repo-root plugins)
     Unpinned `ref` lets the demo silently drift — and when that drift
     includes a broken PHP file, every new Playground load fatals.
  4. Every `git:directory` installPlugin has `options.targetFolderName`.
     Without it, Playground guesses folder names from the repo slug,
     which can collide with `Requires Plugins:` expectations in the
     plugin headers.
  5. Any `installPlugin` with `resource: "url"` must be HTTPS and
     cannot point at `github.com/*/releases/download/…`.
  6. Any `installPlugin` with `resource: "wordpress.org/plugins"` must
     include `slug`, and prefer `targetFolderName` alongside `slug`.
  7. OpenStation must not be installed from `git:directory` because
     its source archives do not include the compiled desktop shell JS
     (`assets/js/desktop.min.js`). Install packaged zips (`downloads.
     wordpress.org` or HTTPS mirrors), never raw plugin source repos.
  8. Public blueprints install OpenStation and ODD from exact
     `downloads.wordpress.org` zip URLs and deterministic folder names.
     The ODD zip may match `odd/odd.php` or the previous public release while
     preparing a release whose dotorg package is not live yet.
  9. Every blueprint requests a Playground PHP runtime that satisfies
     the plugin header's `Requires PHP` value.
 10. Dev blueprints: OpenStation from the pinned release zip matching
     `ODDOUT_OPENSTATION_MIN_VERSION` (targetFolderName desktop-mode);
     ODD from `git:directory` **branch** `main` on
     `RegionallyFamous/odd` with `path` `odd`.
 11. Preview blueprints also write a must-use plugin that points ODD at
     `https://odd.regionallyfamous.com/catalog-preview/v1/registry.json`.
 12. Hosted Playground launchers must not pass `site-slug`; that asks
     Playground for a named site and logs "The requested site was not found"
     before it creates the temporary site we wanted anyway.
"""
from __future__ import annotations

import json
import re
import subprocess
import sys
from pathlib import Path


HERE = Path(__file__).resolve().parent
REPO_ROOT = HERE.parent.parent
BLUEPRINT = REPO_ROOT / "blueprint.json"
BLUEPRINT_DEV = REPO_ROOT / "blueprint-dev.json"
BLUEPRINT_PREVIEW = REPO_ROOT / "blueprint-preview.json"
SITE_BLUEPRINT = REPO_ROOT / "site" / "playground" / "blueprint.json"
SITE_BLUEPRINT_DEV = REPO_ROOT / "site" / "playground" / "blueprint-dev.json"
SITE_BLUEPRINT_PREVIEW = REPO_ROOT / "site" / "playground" / "blueprint-preview.json"
SITE_PLAYGROUND_LAUNCHER = REPO_ROOT / "site" / "playground" / "index.html"
SITE_GO_LAUNCHER = REPO_ROOT / "site" / "go" / "index.html"
SITE_PLAYGROUND_DEV_LAUNCHER = REPO_ROOT / "site" / "playground" / "dev" / "index.html"
SITE_GO_DEV_LAUNCHER = REPO_ROOT / "site" / "go" / "dev" / "index.html"
SITE_PLAYGROUND_PREVIEW_LAUNCHER = REPO_ROOT / "site" / "playground" / "preview" / "index.html"
SITE_GO_PREVIEW_LAUNCHER = REPO_ROOT / "site" / "go" / "preview" / "index.html"
PLUGIN_MAIN = REPO_ROOT / "odd" / "odd.php"
PREVIEW_CATALOG_URL = "https://odd.regionallyfamous.com/catalog-preview/v1/registry.json"
PLAYGROUND_PHP_VERSION = "8.5"
PLAYGROUND_WORDPRESS_VERSION = "7.0.4"
WORDPRESS_CORE_UPDATE_COMMAND = (
    f"wp core update --version={PLAYGROUND_WORDPRESS_VERSION} --force"
)
WORDPRESS_DATABASE_UPDATE_COMMAND = "wp core update-db"


ODD_CONST_RE = re.compile(
    r"define\(\s*['\"]ODDOUT_(VERSION|OPENSTATION_MIN_VERSION)['\"]\s*,\s*['\"]"
    r"([^'\"]+)['\"]\s*\)",
)

OPENSTATION_ZIP_RE = re.compile(
    r"^https://downloads\.wordpress\.org/plugin/"
    r"desktop-mode\.([0-9]+\.[0-9]+\.[0-9]+)\.zip$"
)

ODD_GIT_COMMIT_RE = re.compile(r"^[0-9a-f]{40}$")
ODD_WPORG_ZIP_RE = re.compile(
    r"^https://downloads\.wordpress\.org/plugin/"
    r"odd-outlandish-desktop-decorator\.([0-9]+\.[0-9]+\.[0-9]+)\.zip$"
)
REQUIRES_PHP_RE = re.compile(r"^\s*\*\s*Requires PHP:\s*([0-9]+(?:\.[0-9]+)*)\s*$", re.MULTILINE)

# Dev Playground: pinned current shell from WordPress.org + ODD trunk.


def odd_peeled_tag_commit(repo_root: Path, odd_version: str) -> str | None:
    """Return `git rev-parse v{version}^{commit}` or None when unavailable."""

    if not (repo_root / ".git").exists():
        return None
    tag = "v" + odd_version
    try:
        out = subprocess.check_output(
            ["git", "-C", str(repo_root), "rev-parse", tag + "^{commit}"],
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=30,
        )
    except (
        subprocess.CalledProcessError,
        FileNotFoundError,
        subprocess.TimeoutExpired,
    ):
        return None
    peeled = out.strip()
    return peeled if ODD_GIT_COMMIT_RE.fullmatch(peeled) else None


def openstation_zip_url(openstation_min: str) -> str:
    """Canonical WordPress.org release ZIP URL for pinned OpenStation."""
    return (
        "https://downloads.wordpress.org/"
        + f"plugin/desktop-mode.{openstation_min}.zip"
    )


def odd_zip_url(odd_version: str) -> str:
    """Canonical WordPress.org release zip URL for pinned ODD."""
    return (
        "https://downloads.wordpress.org/"
        + f"plugin/odd-outlandish-desktop-decorator.{odd_version}.zip"
    )


def odd_zip_version(url: str) -> str | None:
    """Return the ODD WordPress.org zip version embedded in a URL."""
    match = ODD_WPORG_ZIP_RE.match(url)
    return match.group(1) if match else None


def odd_php_constants() -> tuple[str, str, str]:
    """Return (ODDOUT_VERSION, OpenStation minimum, Requires PHP)."""
    text = PLUGIN_MAIN.read_text(encoding="utf-8")
    found: dict[str, str] = {}
    for m in ODD_CONST_RE.finditer(text):
        key = m.group(1).lower()
        if key == "version":
            found["version"] = m.group(2)
        elif key == "openstation_min_version":
            found["openstation"] = m.group(2)
    version = found.get("version")
    openstation_min = found.get("openstation")
    requires_php_match = REQUIRES_PHP_RE.search(text)
    requires_php = requires_php_match.group(1) if requires_php_match else None
    if version is None or openstation_min is None or requires_php is None:
        raise SystemExit(
            f"error: could not read ODDOUT_VERSION and "
            f"ODDOUT_OPENSTATION_MIN_VERSION and Requires PHP from {PLUGIN_MAIN}"
        )
    return version, openstation_min, requires_php


def stable_openstation_pin() -> str:
    """Read the stable OpenStation version from the public root blueprint."""
    data = json.loads(BLUEPRINT.read_text(encoding="utf-8"))
    for step in data.get("steps", []):
        if not isinstance(step, dict) or step.get("step") != "installPlugin":
            continue
        plugin = step.get("pluginData")
        if not isinstance(plugin, dict) or plugin.get("resource") != "url":
            continue
        match = OPENSTATION_ZIP_RE.match(str(plugin.get("url", "")))
        if match:
            return match.group(1)
    raise SystemExit(
        f"error: could not read the stable OpenStation pin from {BLUEPRINT}"
    )


def stable_odd_pin() -> str:
    """Read the published ODD version from the public root blueprint."""
    data = json.loads(BLUEPRINT.read_text(encoding="utf-8"))
    for step in data.get("steps", []):
        if not isinstance(step, dict) or step.get("step") != "installPlugin":
            continue
        plugin = step.get("pluginData")
        if not isinstance(plugin, dict) or plugin.get("resource") != "url":
            continue
        version = odd_zip_version(str(plugin.get("url", "")))
        if version:
            return version
    raise SystemExit(f"error: could not read the stable ODD pin from {BLUEPRINT}")


def version_tuple(version: str) -> tuple[int, ...]:
    """Turn a dotted version into comparable integer parts."""
    return tuple(int(part) for part in version.split("."))


def validate_playground_launcher(path: Path, expected_cache_key_part: str = "") -> list[str]:
    """Keep hosted Playground launcher URLs ephemeral and cache-busted."""
    rel = path.relative_to(REPO_ROOT)
    if not path.is_file():
        return [f"{rel} not found — Playground launcher gate cannot run."]
    text = path.read_text(encoding="utf-8")
    problems: list[str] = []
    if "site-slug" in text or "siteSlug" in text:
        problems.append(
            f"{rel}: do not pass site-slug/siteSlug to Playground launch URLs; "
            "it requests a named site and logs a site-not-found warning"
        )
    if "blueprint-url=" not in text:
        problems.append(f"{rel}: launcher must pass blueprint-url to Playground")
    if "oddbp=" not in text:
        problems.append(f"{rel}: launcher must cache-bust blueprint-url with oddbp")
    if expected_cache_key_part and expected_cache_key_part not in text:
        problems.append(
            f"{rel}: launcher cache key must include {expected_cache_key_part!r}"
        )
    return problems


def validate_preferred_versions(data: dict, path: Path, requires_php: str) -> list[str]:
    """Ensure Playground starts a runtime compatible with the plugin header."""
    problems: list[str] = []
    rel = path.relative_to(REPO_ROOT)
    preferred = data.get("preferredVersions")
    if not isinstance(preferred, dict):
        return [f"{rel}: missing preferredVersions; set php to {requires_php} or newer"]

    php = preferred.get("php")
    if not isinstance(php, str) or not php:
        return [f"{rel}: preferredVersions.php must be {requires_php} or newer"]

    try:
        actual = version_tuple(php)
        minimum = version_tuple(requires_php)
    except ValueError:
        return [f"{rel}: preferredVersions.php is not a dotted numeric version: {php!r}"]

    if actual < minimum:
        problems.append(
            f"{rel}: preferredVersions.php must satisfy plugin Requires PHP "
            f"{requires_php}; got {php}"
        )
    if php != PLAYGROUND_PHP_VERSION:
        problems.append(
            f"{rel}: preferredVersions.php must use the current supported stable "
            f"Playground runtime {PLAYGROUND_PHP_VERSION}; got {php}"
        )

    wp = preferred.get("wp")
    if wp != "latest":
        problems.append(
            f'{rel}: preferredVersions.wp must be "latest"; got {wp!r}'
        )
    return problems


def validate_wordpress_update_steps(data: dict, path: Path) -> list[str]:
    """Require the current stable WordPress patch even when Playground lags."""

    rel = path.relative_to(REPO_ROOT)
    commands = [
        step.get("command")
        for step in data.get("steps", [])
        if isinstance(step, dict) and step.get("step") == "wp-cli"
    ]
    problems: list[str] = []
    if WORDPRESS_CORE_UPDATE_COMMAND not in commands:
        problems.append(
            f"{rel}: missing wp-cli step {WORDPRESS_CORE_UPDATE_COMMAND!r}"
        )
    if WORDPRESS_DATABASE_UPDATE_COMMAND not in commands:
        problems.append(
            f"{rel}: missing wp-cli step {WORDPRESS_DATABASE_UPDATE_COMMAND!r}"
        )
    return problems


def fail(problems: list[str]) -> None:
    print("blueprint validation failed:", file=sys.stderr)
    for p in problems:
        print(f"  - {p}", file=sys.stderr)
    sys.exit(1)


def validate_file(path: Path, odd_version: str, openstation_pin: str, requires_php: str) -> tuple[list[str], int]:
    problems: list[str] = []

    if not path.exists():
        return [f"{path.relative_to(REPO_ROOT)} not found — reliability gate cannot run."], 0

    try:
        data = json.loads(path.read_text())
    except json.JSONDecodeError as e:
        return [f"{path.relative_to(REPO_ROOT)} did not parse as JSON: {e}"], 0

    steps = data.get("steps")
    if not isinstance(steps, list) or not steps:
        problems.append("blueprint has no steps array")
    problems.extend(validate_preferred_versions(data, path, requires_php))
    problems.extend(validate_wordpress_update_steps(data, path))

    allowed_ref_types = {"tag", "branch", "commit", "refname"}
    expected_odd_ref = "v" + odd_version
    openstation_zip_expected = openstation_zip_url(openstation_pin)
    odd_zip_expected = odd_zip_url(odd_version)
    openstation_pin_ok = False
    odd_pin_ok = False

    for idx, step in enumerate(steps or []):
        if not isinstance(step, dict):
            problems.append(f"step[{idx}] is not an object")
            continue
        if step.get("step") != "installPlugin":
            continue
        plugin = step.get("pluginData")
        if not isinstance(plugin, dict):
            problems.append(f"step[{idx}].pluginData is not an object")
            continue

        resource = plugin.get("resource", "")
        options = step.get("options") or {}

        if resource == "url":
            url = str(plugin.get("url", ""))
            if "github.com" in url and "/releases/" in url and "/download/" in url:
                problems.append(
                    f"step[{idx}] installs from a GitHub release asset — "
                    "CORS-blocked from Playground; mirror the packaged zip to a CORS-safe static URL"
                )
            if not url.startswith("https://"):
                problems.append(
                    f"step[{idx}] resource=url must be https, got {url!r}"
                )
            if url == openstation_zip_expected:
                if options.get("targetFolderName") != "desktop-mode":
                    problems.append(
                        f"step[{idx}] OpenStation ZIP must use "
                        'options.targetFolderName "desktop-mode"'
                    )
                else:
                    openstation_pin_ok = True
            elif url == odd_zip_expected:
                if options.get("targetFolderName") != "odd-outlandish-desktop-decorator":
                    problems.append(
                        f"step[{idx}] ODD zip must use "
                        'options.targetFolderName "odd-outlandish-desktop-decorator"'
                    )
                else:
                    odd_pin_ok = True
            else:
                odd_lag_version = odd_zip_version(url)
                if odd_lag_version is not None:
                    if options.get("targetFolderName") != "odd-outlandish-desktop-decorator":
                        problems.append(
                            f"step[{idx}] ODD zip must use "
                            'options.targetFolderName "odd-outlandish-desktop-decorator"'
                        )
                    elif version_tuple(odd_lag_version) < version_tuple(odd_version):
                        print(
                            f"note: {path.relative_to(REPO_ROOT)} keeps public "
                            f"Playground on ODD {odd_lag_version} while "
                            f"preparing {odd_version}"
                        )
                        odd_pin_ok = True
                    else:
                        problems.append(
                            f"step[{idx}] ODD WordPress.org zip must be "
                            f"{odd_zip_expected!r} or an older public release "
                            f"during release prep; got {url!r}"
                        )

        elif resource == "wordpress.org/plugins":
            slug = plugin.get("slug")
            if not slug or not isinstance(slug, str):
                problems.append(
                    f"step[{idx}] wordpress.org/plugins install is missing "
                    "`pluginData.slug`"
                )
                continue

            target = options.get("targetFolderName")
            if not target:
                problems.append(
                    f"step[{idx}] wordpress.org/plugins installPlugin should set "
                    "options.targetFolderName so plugin folder naming is deterministic"
                )
            if slug == "desktop-mode":
                problems.append(
                    f"step[{idx}] public blueprint must pin OpenStation via "
                    f"resource=url → {openstation_zip_expected!r} "
                    "(wordpress.org/plugins slug installs cannot pin a version)"
                )
            elif slug == "odd-outlandish-desktop-decorator":
                problems.append(
                    f"step[{idx}] public blueprint must pin ODD via "
                    f"resource=url → {odd_zip_expected!r} "
                    "(wordpress.org/plugins slug installs cannot pin a version)"
                )

        elif resource == "git:directory":
            url = str(plugin.get("url", ""))
            if "github.com/WordPress/desktop-mode" in url:
                problems.append(
                    f"step[{idx}] installs OpenStation from git:directory — "
                    "source archives miss compiled shell assets; use "
                    "the downloads.wordpress.org release zip URL"
                )
            if not plugin.get("ref"):
                problems.append(
                    f"step[{idx}] git:directory resource is missing `ref` — "
                    "pin to a tag, branch, or SHA so the demo is deterministic"
                )
            ref_type = plugin.get("refType")
            if ref_type not in allowed_ref_types:
                problems.append(
                    f"step[{idx}] git:directory resource has refType={ref_type!r}; "
                    f"allowed: {sorted(allowed_ref_types)}"
                )
            if "path" not in plugin:
                problems.append(
                    f"step[{idx}] git:directory resource must specify `path` (use '/' for repo-root plugins)"
                )
            if not options.get("targetFolderName"):
                problems.append(
                    f"step[{idx}] git:directory installPlugin must set options.targetFolderName "
                    "so the plugin folder matches what `Requires Plugins:` expects"
                )
            if "RegionallyFamous/odd" in url:
                problems.append(
                    f"step[{idx}] public Playground should install ODD from "
                    f"the pinned WordPress.org zip {odd_zip_expected!r}"
                )
                ref = str(plugin.get("ref", ""))
                expected_tag_ref = expected_odd_ref
                if ref_type == "tag":
                    if ref != expected_tag_ref:
                        problems.append(
                            f"step[{idx}] ODD git tag ref must be "
                            f"{expected_tag_ref!r}; got {ref!r}"
                        )
                elif ref_type == "commit":
                    if not ODD_GIT_COMMIT_RE.fullmatch(ref):
                        problems.append(
                            f"step[{idx}] ODD git commit ref must be "
                            f"40-char lowercase hex; got {ref!r}"
                        )
                    else:
                        peeled = odd_peeled_tag_commit(REPO_ROOT, odd_version)
                        if peeled is not None and peeled != ref:
                            problems.append(
                                f"step[{idx}] ODD git commit must peel "
                                f"v{odd_version}: expected {peeled}; got {ref}"
                            )
                else:
                    problems.append(
                        f"step[{idx}] RegionallyFamous/odd installs must use "
                        f'refType \"tag\" or \"commit\"; got {ref_type!r}'
                    )

    rel = path.relative_to(REPO_ROOT)
    if not openstation_pin_ok:
        problems.append(
            f"{rel}: missing pinned WordPress.org OpenStation release "
            f"(resource=url, url={openstation_zip_expected!r}, "
            "targetFolderName=desktop-mode)"
        )
    if not odd_pin_ok:
        problems.append(
            f"{rel}: missing pinned WordPress.org ODD release "
            f"(resource=url, url={odd_zip_expected!r} or an older public release, "
            "targetFolderName=odd-outlandish-desktop-decorator)"
        )

    return problems, len(steps or [])


def validate_dev_file(path: Path, openstation_min: str, requires_php: str) -> tuple[list[str], int]:
    """Lint the trunk / pinned-OpenStation dev blueprint."""

    problems: list[str] = []

    if not path.exists():
        return [f"{path.relative_to(REPO_ROOT)} not found — dev blueprint gate cannot run."], 0

    try:
        data = json.loads(path.read_text())
    except json.JSONDecodeError as e:
        return [f"{path.relative_to(REPO_ROOT)} did not parse as JSON: {e}"], 0

    steps = data.get("steps")
    if not isinstance(steps, list) or not steps:
        problems.append("blueprint has no steps array")
    problems.extend(validate_preferred_versions(data, path, requires_php))
    problems.extend(validate_wordpress_update_steps(data, path))

    allowed_ref_types = {"tag", "branch", "commit", "refname"}
    pinned_openstation_release = False
    pinned_odd_trunk = False
    openstation_zip_expected = openstation_zip_url(openstation_min)

    for idx, step in enumerate(steps or []):
        if not isinstance(step, dict):
            problems.append(f"step[{idx}] is not an object")
            continue
        if step.get("step") != "installPlugin":
            continue
        plugin = step.get("pluginData")
        if not isinstance(plugin, dict):
            problems.append(f"step[{idx}].pluginData is not an object")
            continue

        resource = plugin.get("resource", "")
        options = step.get("options") or {}

        if resource == "url":
            url = str(plugin.get("url", ""))
            if "github.com" in url and "/releases/" in url and "/download/" in url:
                problems.append(
                    f"step[{idx}] installs from a GitHub release asset — "
                    "CORS-blocked from Playground; mirror the packaged zip to a CORS-safe static URL"
                )
            if not url.startswith("https://"):
                problems.append(
                    f"step[{idx}] resource=url must be https, got {url!r}"
                )
            if url == openstation_zip_expected:
                if options.get("targetFolderName") != "desktop-mode":
                    problems.append(
                        f"step[{idx}] OpenStation ZIP must use "
                        'options.targetFolderName "desktop-mode"'
                    )
                else:
                    pinned_openstation_release = True

        elif resource == "wordpress.org/plugins":
            slug = plugin.get("slug")
            if slug == "desktop-mode":
                problems.append(
                    f"step[{idx}] dev blueprint must install OpenStation via "
                    f"resource=url → {openstation_zip_expected!r} "
                    "(wordpress.org/plugins slug installs cannot pin a version)"
                )

        elif resource == "git:directory":
            url = str(plugin.get("url", ""))
            if "github.com/WordPress/desktop-mode" in url:
                problems.append(
                    f"step[{idx}] installs OpenStation from git:directory — "
                    "source archives miss compiled shell assets; use "
                    "the downloads.wordpress.org zip URL"
                )
            if not plugin.get("ref"):
                problems.append(
                    f"step[{idx}] git:directory resource is missing `ref`"
                )
            ref_type = plugin.get("refType")
            if ref_type not in allowed_ref_types:
                problems.append(
                    f"step[{idx}] git:directory resource has refType={ref_type!r}; "
                    f"allowed: {sorted(allowed_ref_types)}"
                )
            if "path" not in plugin:
                problems.append(
                    f"step[{idx}] git:directory resource must specify `path`"
                )
            if not options.get("targetFolderName"):
                problems.append(
                    f"step[{idx}] git:directory installPlugin must set options.targetFolderName"
                )
            if "RegionallyFamous/odd" in url:
                ref = str(plugin.get("ref", ""))
                if ref_type != "branch" or ref != "main":
                    problems.append(
                        f"step[{idx}] dev ODD must use refType \"branch\" and "
                        f'ref \"main\"; got {ref_type!r} {ref!r}'
                    )
                else:
                    pinned_odd_trunk = True

    rel = path.relative_to(REPO_ROOT)
    if not pinned_openstation_release:
        problems.append(
            f"{rel}: dev blueprint must install OpenStation from "
            f"{openstation_zip_expected!r} (resource=url, targetFolderName=desktop-mode)"
        )
    if not pinned_odd_trunk:
        problems.append(
            f"{rel}: dev blueprint must install ODD from branch main "
            "(git:directory → github.com/RegionallyFamous/odd, path odd)"
        )

    return problems, len(steps or [])


def validate_preview_file(path: Path, openstation_min: str, requires_php: str) -> tuple[list[str], int]:
    """Lint the trunk + hosted-preview-catalog blueprint."""

    problems: list[str] = []

    if not path.exists():
        return [f"{path.relative_to(REPO_ROOT)} not found — preview blueprint gate cannot run."], 0

    try:
        data = json.loads(path.read_text())
    except json.JSONDecodeError as e:
        return [f"{path.relative_to(REPO_ROOT)} did not parse as JSON: {e}"], 0

    steps = data.get("steps")
    if not isinstance(steps, list) or not steps:
        problems.append("blueprint has no steps array")
    problems.extend(validate_preferred_versions(data, path, requires_php))
    problems.extend(validate_wordpress_update_steps(data, path))

    allowed_ref_types = {"tag", "branch", "commit", "refname"}
    pinned_openstation_release = False
    pinned_odd_trunk = False
    preview_mu_plugin_dir = False
    preview_mu_plugin = False
    openstation_zip_expected = openstation_zip_url(openstation_min)

    for idx, step in enumerate(steps or []):
        if not isinstance(step, dict):
            problems.append(f"step[{idx}] is not an object")
            continue

        if step.get("step") == "mkdir":
            if step.get("path") == "/wordpress/wp-content/mu-plugins":
                preview_mu_plugin_dir = True
            continue

        if step.get("step") == "writeFile":
            data_value = str(step.get("data", ""))
            if step.get("path") == "/wordpress/wp-content/mu-plugins/odd-preview-catalog.php":
                if (
                    PREVIEW_CATALOG_URL in data_value
                    and "oddout_catalog_url" in data_value
                    and "oddout_catalog_signature_required" in data_value
                ):
                    preview_mu_plugin = True
                else:
                    problems.append(
                        f"step[{idx}] preview mu-plugin must set oddout_catalog_url "
                        f"to {PREVIEW_CATALOG_URL!r}"
                    )
            continue

        if step.get("step") != "installPlugin":
            continue
        plugin = step.get("pluginData")
        if not isinstance(plugin, dict):
            problems.append(f"step[{idx}].pluginData is not an object")
            continue

        resource = plugin.get("resource", "")
        options = step.get("options") or {}

        if resource == "url":
            url = str(plugin.get("url", ""))
            if "github.com" in url and "/releases/" in url and "/download/" in url:
                problems.append(
                    f"step[{idx}] installs from a GitHub release asset — "
                    "CORS-blocked from Playground; mirror the packaged zip to a CORS-safe static URL"
                )
            if not url.startswith("https://"):
                problems.append(
                    f"step[{idx}] resource=url must be https, got {url!r}"
                )
            if url == openstation_zip_expected:
                if options.get("targetFolderName") != "desktop-mode":
                    problems.append(
                        f"step[{idx}] OpenStation ZIP must use "
                        'options.targetFolderName "desktop-mode"'
                    )
                else:
                    pinned_openstation_release = True

        elif resource == "wordpress.org/plugins":
            slug = plugin.get("slug")
            if slug == "desktop-mode":
                problems.append(
                    f"step[{idx}] preview blueprint must install OpenStation via "
                    f"resource=url → {openstation_zip_expected!r} "
                    "(wordpress.org/plugins slug installs cannot pin a version)"
                )

        elif resource == "git:directory":
            url = str(plugin.get("url", ""))
            if "github.com/WordPress/desktop-mode" in url:
                problems.append(
                    f"step[{idx}] installs OpenStation from git:directory — "
                    "source archives miss compiled shell assets; use "
                    "the downloads.wordpress.org zip URL"
                )
            if not plugin.get("ref"):
                problems.append(
                    f"step[{idx}] git:directory resource is missing `ref`"
                )
            ref_type = plugin.get("refType")
            if ref_type not in allowed_ref_types:
                problems.append(
                    f"step[{idx}] git:directory resource has refType={ref_type!r}; "
                    f"allowed: {sorted(allowed_ref_types)}"
                )
            if "path" not in plugin:
                problems.append(
                    f"step[{idx}] git:directory resource must specify `path`"
                )
            if not options.get("targetFolderName"):
                problems.append(
                    f"step[{idx}] git:directory installPlugin must set options.targetFolderName"
                )
            if "RegionallyFamous/odd" in url:
                ref = str(plugin.get("ref", ""))
                if ref_type != "branch" or ref != "main":
                    problems.append(
                        f"step[{idx}] preview ODD must use refType \"branch\" and "
                        f'ref \"main\"; got {ref_type!r} {ref!r}'
                    )
                elif plugin.get("path") != "odd":
                    problems.append(
                        f"step[{idx}] preview ODD git:directory path must be \"odd\""
                    )
                else:
                    pinned_odd_trunk = True

    rel = path.relative_to(REPO_ROOT)
    if not preview_mu_plugin_dir:
        problems.append(
            f"{rel}: preview blueprint must create /wordpress/wp-content/mu-plugins"
        )
    if not preview_mu_plugin:
        problems.append(
            f"{rel}: preview blueprint must write an odd-preview-catalog.php mu-plugin"
        )
    if not pinned_openstation_release:
        problems.append(
            f"{rel}: preview blueprint must install OpenStation from "
            f"{openstation_zip_expected!r} (resource=url, targetFolderName=desktop-mode)"
        )
    if not pinned_odd_trunk:
        problems.append(
            f"{rel}: preview blueprint must install ODD from branch main "
            "(git:directory → github.com/RegionallyFamous/odd, path odd)"
        )

    return problems, len(steps or [])


def main() -> int:
    if not PLUGIN_MAIN.is_file():
        print(f"error: missing {PLUGIN_MAIN}", file=sys.stderr)
        return 1
    odd_version, openstation_min, requires_php = odd_php_constants()
    stable_pin = stable_openstation_pin()
    stable_odd_version = stable_odd_pin()
    problems: list[str] = []
    total_steps = 0
    for path in (BLUEPRINT, SITE_BLUEPRINT):
        file_problems, step_count = validate_file(path, odd_version, stable_pin, requires_php)
        problems.extend(file_problems)
        total_steps += step_count

    for path in (BLUEPRINT_DEV, SITE_BLUEPRINT_DEV):
        file_problems, step_count = validate_dev_file(path, openstation_min, requires_php)
        problems.extend(file_problems)
        total_steps += step_count

    for path in (BLUEPRINT_PREVIEW, SITE_BLUEPRINT_PREVIEW):
        file_problems, step_count = validate_preview_file(path, openstation_min, requires_php)
        problems.extend(file_problems)
        total_steps += step_count

    runtime_cache_key = (
        f"os-{stable_pin}-wp-{PLAYGROUND_WORDPRESS_VERSION}"
        f"-php-{PLAYGROUND_PHP_VERSION}"
    )
    stable_cache_key = f"wporg-odd-{stable_odd_version}-{runtime_cache_key}"
    for path in (SITE_PLAYGROUND_LAUNCHER, SITE_GO_LAUNCHER):
        problems.extend(validate_playground_launcher(path, stable_cache_key))

    dev_cache_key_part = (
        f"os-{openstation_min}-wp-{PLAYGROUND_WORDPRESS_VERSION}"
        f"-php-{PLAYGROUND_PHP_VERSION}"
    )
    for path in (SITE_PLAYGROUND_DEV_LAUNCHER, SITE_GO_DEV_LAUNCHER):
        problems.extend(validate_playground_launcher(path, dev_cache_key_part))

    preview_cache_key_part = (
        f"os-{openstation_min}-wp-{PLAYGROUND_WORDPRESS_VERSION}"
        f"-php-{PLAYGROUND_PHP_VERSION}"
    )
    for path in (SITE_PLAYGROUND_PREVIEW_LAUNCHER, SITE_GO_PREVIEW_LAUNCHER):
        problems.extend(validate_playground_launcher(path, preview_cache_key_part))

    if problems:
        fail(problems)
        return 1

    print(
        "blueprints ok: "
        f"{total_steps} total steps across release + dev + preview copies, "
        "no CORS-fragile or release-misconfigured installs"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
