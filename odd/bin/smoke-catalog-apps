function smokeRenderedContent( raw ) {
	return String( raw || '' ).replace( /<!--([\s\S]*?)-->/g, '' );
}

async function maybeServeWpApiStub( req, res, pathname, patterns, editorial ) {
	const collectionPath = '/wp-json/wp/v2/blocks';
	if ( pathname === collectionPath ) {
		if ( req.method === 'GET' ) {
			sendJson( res, 200, patterns, {
				'x-wp-total': String( patterns.length ),
				'x-wp-totalpages': '1',
			} );
			return true;
		}
		if ( req.method === 'POST' ) {
			let payload = {};
			try {
				payload = JSON.parse( await readRequestBody( req ) || '{}' );
			} catch ( _error ) {
				payload = {};
			}
			const id = patterns.reduce( ( highest, pattern ) => Math.max( highest, pattern.id ), 100 ) + 1;
			const now = new Date().toISOString().slice( 0, 19 );
			const created = {
				id,
				date: now,
				modified: now,
				status: payload.status || 'publish',
				title: { raw: String( payload.title || 'Untitled pattern' ), rendered: String( payload.title || 'Untitled pattern' ) },
				content: { raw: String( payload.content || '' ), rendered: smokeRenderedContent( payload.content ) },
			};
			patterns.unshift( created );
			sendJson( res, 201, created );
			return true;
		}
	}

	const revisionsMatch = pathname.match( /^\/wp-json\/wp\/v2\/(posts|pages)\/(\d+)\/revisions$/ );
	if ( revisionsMatch && req.method === 'GET' ) {
		const key = `${ revisionsMatch[ 1 ] }/${ revisionsMatch[ 2 ] }`;
		const rows = editorial.revisions[ key ] || [];
		sendJson( res, 200, rows, { 'x-wp-total': String( rows.length ), 'x-wp-totalpages': '1' } );
		return true;
	}

	const editorialCollection = pathname.match( /^\/wp-json\/wp\/v2\/(posts|pages)$/ );
	if ( editorialCollection && req.method === 'GET' ) {
		const type = editorialCollection[ 1 ];
		const requestUrl = new URL( req.url || '/', 'http://127.0.0.1' );
		const rawStatuses = [ requestUrl.searchParams.get( 'status' ), ...requestUrl.searchParams.getAll( 'status[]' ) ].filter( Boolean ).join( ',' );
		const statuses = new Set( rawStatuses.split( ',' ).filter( Boolean ) );
		const rows = editorial[ type ].filter( ( item ) => ! statuses.size || statuses.has( item.status ) );
		sendJson( res, 200, rows, { 'x-wp-total': String( rows.length ), 'x-wp-totalpages': '1' } );
		return true;
	}

	const editorialItem = pathname.match( /^\/wp-json\/wp\/v2\/(posts|pages)\/(\d+)$/ );
	if ( editorialItem ) {
		const type = editorialItem[ 1 ];
		const id = Number( editorialItem[ 2 ] );
		const index = editorial[ type ].findIndex( ( item ) => item.id === id );
		if ( index < 0 ) {
			sendJson( res, 404, { code: 'rest_post_invalid_id', message: 'Invalid post ID.' } );
			return true;
		}
		if ( req.method === 'GET' ) {
			sendJson( res, 200, editorial[ type ][ index ] );
			return true;
		}
		if ( req.method === 'POST' ) {
			let payload = {};
			try { payload = JSON.parse( await readRequestBody( req ) || '{}' ); } catch ( _error ) { payload = {}; }
			const current = editorial[ type ][ index ];
			const next = {
				...current,
				...payload,
				modified: '2026-08-17T12:00:00',
				modified_gmt: '2026-08-17T19:00:00',
				title: payload.title === undefined ? current.title : { raw: String( payload.title ), rendered: String( payload.title ) },
				content: payload.content === undefined ? current.content : { raw: String( payload.content ), rendered: smokeRenderedContent( payload.content ) },
				excerpt: payload.excerpt === undefined ? current.excerpt : { raw: String( payload.excerpt ), rendered: smokeRenderedContent( payload.excerpt ) },
			};
			editorial[ type ].splice( index, 1, next );
			sendJson( res, 200, next );
			return true;
		}
	}

	const itemMatch = pathname.match( /^\/wp-json\/wp\/v2\/blocks\/(\d+)$/ );
	if ( ! itemMatch ) {
		return false;
	}
	const id = Number( itemMatch[ 1 ] );
	const index = patterns.findIndex( ( pattern ) => pattern.id === id );
	if ( index < 0 ) {
		sendJson( res, 404, { code: 'rest_post_invalid_id', message: 'Invalid pattern ID.' } );
		return true;
	}
	if ( req.method === 'GET' ) {
		sendJson( res, 200, patterns[ index ] );
		return true;
	}
	if ( req.method === 'POST' ) {
		let payload = {};
		try {
			payload = JSON.parse( await readRequestBody( req ) || '{}' );
		} catch ( _error ) {
			payload = {};
		}
		const current = patterns[ index ];
		const next = {
			...current,
			modified: new Date().toISOString().slice( 0, 19 ),
			title: payload.title === undefined ? current.title : { raw: String( payload.title ), rendered: String( payload.title ) },
			content: payload.content === undefined ? current.content : { raw: String( payload.content ), rendered: smokeRenderedContent( payload.content ) },
		};
		patterns.splice( index, 1, next );
		sendJson( res, 200, next );
		return true;
	}
	if ( req.method === 'DELETE' ) {
		const [ previous ] = patterns.splice( index, 1 );
		sendJson( res, 200, { deleted: true, previous } );
		return true;
	}

	sendJson( res, 405, { code: 'rest_no_route', message: 'Unsupported smoke request.' } );
	return true;
}

async function maybeServeOddApiStub( req, res, pathname, appStore ) {
	const restPath = pathname.startsWith( '/wp-json/odd/v1/' )
		? pathname.slice( '/wp-json'.length )
		: pathname;
	if ( ! restPath.startsWith( '/odd/v1/' ) ) {
		return false;
	}

	const storeSegment = restPath.match( /^\/odd\/v1\/apps\/store\/([a-z0-9-]+)\/([A-Za-z0-9-]+)$/ );
	if ( storeSegment ) {
		const key = `${ storeSegment[ 1 ] }/${ storeSegment[ 2 ].toLowerCase() }`;
		if ( req.method === 'GET' ) {
			sendJson( res, 200, { value: appStore.has( key ) ? appStore.get( key ) : null } );
			return true;
		}
		if ( req.method === 'POST' || req.method === 'PUT' ) {
			let parsed = {};
			try {
				parsed = JSON.parse( await readRequestBody( req ) || '{}' );
			} catch ( _error ) {
				parsed = {};
			}
			const value = Object.prototype.hasOwnProperty.call( parsed, 'value' ) ? parsed.value : null;
			appStore.set( key, value );
			sendJson( res, 200, { value } );
			return true;
		}
		if ( req.method === 'DELETE' ) {
			appStore.delete( key );
			res.writeHead( 204 );
			res.end();
			return true;
		}
	}

	const storeKeys = restPath.match( /^\/odd\/v1\/apps\/store\/([a-z0-9-]+)$/ );
	if ( storeKeys ) {
		const slugPrefix = `${ storeKeys[ 1 ] }/`;
		if ( req.method === 'GET' ) {
			const keys = Array.from( appStore.keys() )
				.filter( ( key ) => key.startsWith( slugPrefix ) )
				.map( ( key ) => key.slice( slugPrefix.length ) )
				.sort();
			sendJson( res, 200, keys );
			return true;
		}
		if ( req.method === 'DELETE' ) {
			for ( const key of Array.from( appStore.keys() ) ) {
				if ( key.startsWith( slugPrefix ) ) {
					appStore.delete( key );
				}
			}
			res.writeHead( 204 );
			res.end();
			return true;
		}
	}

	sendJson( res, 404, { code: 'not_found', message: 'Smoke API stub has no route for this request.' } );
	return true;
}

function serveDirectory( root ) {
	const appStore = new Map();
	const wpPatterns = createWpPatternFixtures();
	const wpEditorial = createWpEditorialFixtures();
	const server = http.createServer( async ( req, res ) => {
		try {
			const url = new URL( req.url || '/', 'http://127.0.0.1' );
			let pathname = decodeURIComponent( url.pathname );
			if ( await maybeServeOddApiStub( req, res, pathname, appStore ) ) {
				return;
			}
			if ( await maybeServeWpApiStub( req, res, pathname, wpPatterns, wpEditorial ) ) {
				return;
			}
			if ( pathname.endsWith( '/' ) ) {
				pathname += 'index.html';
			}
			const filePath = path.resolve( root, '.' + pathname );
			if ( ! filePath.startsWith( root + path.sep ) ) {
				res.writeHead( 403 );
				res.end( 'forbidden' );
				return;
			}
			const raw = await fsp.readFile( filePath );
			res.writeHead( 200, {
				'content-type': contentTypeFor( filePath ),
				'x-content-type-options': 'nosniff',
			} );
			res.end( raw );
		} catch ( error ) {
			res.writeHead( error && error.code === 'ENOENT' ? 404 : 500 );
			res.end( 'not found' );
		}
	} );

	return new Promise( ( resolve, reject ) => {
		server.on( 'error', reject );
		server.listen( 0, '127.0.0.1', () => {
			const address = server.address();
			resolve( {
				baseUrl: `http://127.0.0.1:${ address.port }`,
				close: () => new Promise( ( done ) => server.close( done ) ),
			} );
		} );
	} );
}

function runChecked( cmd, args, options = {} ) {
	const result = spawnSync( cmd, args, {
		cwd: REPO_ROOT,
		encoding: 'utf8',
		...options,
	} );
	if ( result.status !== 0 ) {
		throw new Error( [
			`${ cmd } ${ args.join( ' ' ) } failed with exit ${ result.status }`,
			result.stdout && result.stdout.trim(),
			result.stderr && result.stderr.trim(),
		].filter( Boolean ).join( '\n' ) );
	}
	return result;
}

function extractBundle( slug, tempRoot ) {
	const sourceDir = path.join( APPS_DIR, slug );
	const bundlePath = path.join( CATALOG_BUNDLES_DIR, `${ slug }.wp` );
	const extractDir = path.join( tempRoot, slug );
	if ( ! fs.existsSync( sourceDir ) ) {
		throw new Error( `${ slug }: missing app source directory` );
	}
	if ( ! fs.existsSync( bundlePath ) ) {
		throw new Error( `${ slug }: missing built catalog bundle` );
	}
	fs.mkdirSync( extractDir, { recursive: true } );
	runChecked( 'unzip', [ '-qq', bundlePath, '-d', extractDir ] );
	const manifestPath = path.join( extractDir, 'manifest.json' );
	if ( ! fs.existsSync( manifestPath ) ) {
		throw new Error( `${ slug }: bundle.wp did not contain manifest.json` );
	}
	runChecked( VALIDATE_MANIFEST, [ manifestPath ] );
	const manifest = JSON.parse( fs.readFileSync( manifestPath, 'utf8' ) );
	if ( manifest.type !== 'app' ) {
		throw new Error( `${ slug }: manifest type must be "app"` );
	}
	if ( manifest.slug !== slug ) {
		throw new Error( `${ slug }: manifest slug is "${ manifest.slug }"` );
	}
	const entry = manifest.entry || 'index.html';
	if ( ! fs.existsSync( path.join( extractDir, entry ) ) ) {
		throw new Error( `${ slug }: entry "${ entry }" missing from bundle.wp` );
	}
	return { slug, bundlePath, extractDir, manifest, entry };
}

async function exercisePantry( page, viewport ) {
	await page.locator( '#pattern-grid .pattern-card:not(.pattern-card--skeleton)' ).first().waitFor();
	await page.locator( '#pattern-grid .pattern-card:not(.pattern-card--skeleton)' ).first().click();
	const preview = page.locator( '#pattern-preview iframe' );
	await preview.waitFor();
	if ( await preview.getAttribute( 'sandbox' ) !== '' ) {
		throw new Error( 'pantry preview iframe is missing its empty sandbox policy' );
	}
	if ( await preview.getAttribute( 'referrerpolicy' ) !== 'no-referrer' ) {
		throw new Error( 'pantry preview iframe is missing its no-referrer policy' );
	}
	const srcdoc = await preview.getAttribute( 'srcdoc' ) || '';
	if ( ! srcdoc.includes( "default-src 'none'" ) ) {
		throw new Error( 'pantry preview iframe is missing its restrictive CSP' );
	}

	await page.locator( '#favorite-pattern' ).click();
	if ( viewport.name !== 'desktop' ) {
		await page.locator( '#close-inspector' ).click();
	}
	await page.locator( '#pattern-search' ).fill( 'announcement' );
	await page.locator( '#pattern-grid .pattern-card' ).first().waitFor();
	await page.locator( '#pattern-search' ).fill( '' );

	if ( viewport.name !== 'desktop' ) {
		return;
	}

	await page.locator( '#new-pattern' ).click();
	await page.locator( '#new-pattern-title' ).fill( 'Smoke shelf pattern' );
	await page.locator( '#create-submit' ).click();
	await page.getByText( 'Smoke shelf pattern', { exact: true } ).first().waitFor();
	await page.locator( '#rename-pattern' ).click();
	await page.locator( '#rename-input' ).fill( 'Smoke shelf pattern renamed' );
	await page.locator( '#title-editor [type="submit"]' ).click();
	await page.getByText( 'Smoke shelf pattern renamed', { exact: true } ).first().waitFor();
	await page.locator( '#duplicate-pattern' ).click();
	await page.getByText( 'Smoke shelf pattern renamed copy', { exact: true } ).first().waitFor();
	await page.locator( '#trash-pattern' ).click();
	await page.locator( '#trash-form [value="trash"]' ).click();
	await page.locator( '#pattern-grid .pattern-card h2', { hasText: 'Smoke shelf pattern renamed copy' } ).waitFor( { state: 'detached' } );
}

async function exerciseWorkbench( page, viewport ) {
	const rail = page.locator( '.tool-rail' );
	const expectedOrientation = viewport.width <= 560 ? 'horizontal' : 'vertical';
	if ( await rail.getAttribute( 'aria-orientation' ) !== expectedOrientation ) {
		throw new Error( `workbench tab orientation does not match ${ viewport.name } layout` );
	}
	const tabs = page.locator( '[role="tab"]' );
	for ( let index = 0; index < await tabs.count(); index++ ) {
		if ( ! await tabs.nth( index ).getAttribute( 'aria-label' ) ) {
			throw new Error( `workbench tab ${ index + 1 } has no accessible name` );
		}
	}
	await page.locator( '[data-tool="clean"]' ).focus();
	await page.keyboard.press( expectedOrientation === 'horizontal' ? 'ArrowRight' : 'ArrowDown' );
	if ( await page.locator( '[data-tool="markdown"]' ).getAttribute( 'aria-selected' ) !== 'true' ) {
		throw new Error( 'workbench did not move to the next tab on the layout axis' );
	}
	await page.locator( '#markdown-input' ).fill( '<img src=x onerror=alert(1)>\n[unsafe](javascript:alert(2))' );
	if ( await page.locator( '#markdown-preview img, #markdown-preview script, #markdown-preview svg' ).count() ) {
		throw new Error( 'workbench rendered hostile Markdown as active DOM' );
	}
}

async function exerciseRevisionRoom( page ) {
	await page.locator( '#document-list [data-document-key]' ).first().waitFor();
	await page.locator( '#revision-list [data-revision-id]' ).first().waitFor();
	await page.locator( '#field-tabs input[value="content"]' ).check( { force: true } );
	if ( await page.locator( '#diff-output .diff-row' ).count() < 1 ) {
		throw new Error( 'revision-room did not render a comparison' );
	}
	if ( await page.locator( '#diff-output script, #diff-output form, #diff-output svg' ).count() ) {
		throw new Error( 'revision-room rendered document markup as active DOM' );
	}
	await page.locator( '#restore-revision' ).click();
	await page.getByText( /Revision restored/ ).waitFor();
	await page.waitForFunction( () => document.activeElement?.id === 'restore-revision' );
	await page.evaluate( () => document.querySelector( '.workspace' )?.scrollTo( 0, 0 ) );
}

async function exerciseAirdate( page, viewport ) {
	await page.locator( '#queue-list [data-schedule-key]' ).first().waitFor();
	if ( viewport.name === 'compact' ) {
		for ( const selector of [ '#previous-month','#today-month','#month-heading','#next-month','#refresh-schedule' ] ) {
			const control = page.locator( selector ); const box = await control.boundingBox();
			if ( ! box || box.x < 0 || box.x + box.width > viewport.width ) throw new Error( `airdate compact topbar control is clipped: ${ selector }` );
			if ( selector !== '#month-heading' && ( box.width < 32 || box.height < 32 ) ) throw new Error( `airdate compact hit target is smaller than 32px: ${ selector }` );
			if ( selector !== '#month-heading' ) {
				const hitId = await page.evaluate( ( point ) => document.elementFromPoint( point.x,point.y )?.closest( 'button' )?.id || '',{ x:box.x + box.width / 2,y:box.y + box.height / 2 } );
				if ( hitId !== selector.slice( 1 ) ) throw new Error( `airdate compact topbar control is covered: ${ selector } hit ${ hitId || 'nothing' }` );
			}
		}
		return;
	}
	await page.locator( '#queue-list [data-schedule-key]' ).first().click();
	await page.locator( '#schedule-dialog[open]' ).waitFor();
	await page.locator( '#airdate-input' ).evaluate( ( input ) => {
		const target = new Date( Date.now() + 2 * 60 * 60 * 1000 );
		const pad = ( value ) => String( value ).padStart( 2, '0' );
		input.value = `${ target.getFullYear() }-${ pad( target.getMonth() + 1 ) }-${ pad( target.getDate() ) }T${ pad( target.getHours() ) }:${ pad( target.getMinutes() ) }`;
	} );
	await page.locator( '#schedule-submit' ).click();
	await page.getByText( /is scheduled for/ ).waitFor();
	const scheduled = page.locator( '#agenda-list [data-schedule-key], #calendar-grid [data-schedule-key]' );
	await scheduled.first().waitFor( { state: 'attached' } );
	let visibleScheduled = null;
	for ( let index = 0; index < await scheduled.count(); index++ ) {
		if ( await scheduled.nth( index ).isVisible() ) {
			visibleScheduled = scheduled.nth( index );
			break;
		}
	}
	if ( ! visibleScheduled ) {
		throw new Error( 'airdate did not expose a visible scheduled action' );
	}
	await visibleScheduled.click();
	await page.locator( '#cancel-airdate:not([hidden])' ).waitFor();
	await page.locator( '#cancel-airdate' ).click();
	await page.getByText( /returned to drafts/ ).waitFor();
	await page.evaluate( () => document.querySelector( '.workspace' )?.scrollTo( 0, 0 ) );
}

async function exerciseSubmissions( page, viewport ) {
	await page.locator( '#submission-list [data-submission-key]' ).first().waitFor();
	await page.locator( '#submission-list [data-submission-key]' ).first().click();
	const inspector = page.locator( '#submission-inspector' );
	if ( await inspector.getAttribute( 'aria-hidden' ) !== 'false' ) {
		throw new Error( 'submissions inspector did not open' );
	}
	await page.waitForFunction( () => window.getComputedStyle( document.querySelector( '#submission-inspector' ) ).opacity === '1' );
	if ( viewport.width <= 780 && await inspector.getAttribute( 'aria-modal' ) !== 'true' ) {
		throw new Error( 'submissions mobile inspector is not modal' );
	}
	if ( viewport.width <= 780 ) {
		const backgroundAlpha = await inspector.evaluate( ( element ) => {
			const match = window.getComputedStyle( element ).backgroundColor.match( /^rgba?\([^,]+,[^,]+,[^,]+(?:,\s*([\d.]+))?\)$/ );
			return match ? Number( match[ 1 ] ?? 1 ) : 0;
		} );
		if ( backgroundAlpha !== 1 ) throw new Error( `submissions mobile inspector background is translucent (alpha ${ backgroundAlpha })` );
	}
	const frame = page.locator( '#submission-preview iframe' );
	await frame.waitFor();
	if ( await frame.getAttribute( 'sandbox' ) !== '' || await frame.getAttribute( 'referrerpolicy' ) !== 'no-referrer' ) {
		throw new Error( 'submissions preview iframe policy is incomplete' );
	}
	const srcdoc = await frame.getAttribute( 'srcdoc' ) || '';
	if ( ! srcdoc.includes( "default-src 'none'" ) || /on(?:click|error|load)=|<script|<form|<input|<svg|evil\.example/i.test( srcdoc ) ) {
		throw new Error( 'submissions preview sanitizer allowed hostile content' );
	}
	if ( viewport.name === 'compact' ) {
		const inspectorBox = await inspector.boundingBox();
		if ( ! inspectorBox ) {
			throw new Error( 'submissions compact inspector has no layout box' );
		}
		const scrollMetrics = await inspector.evaluate( ( element ) => ( { clientHeight: element.clientHeight, scrollHeight: element.scrollHeight } ) );
		if ( scrollMetrics.scrollHeight <= scrollMetrics.clientHeight ) {
			throw new Error( 'submissions compact inspector did not create an internal scroll region' );
		}
		for ( const selector of [ '#approve-submission', '#return-submission', '#open-submission' ] ) {
			const action = page.locator( selector );
			await action.scrollIntoViewIfNeeded();
			const box = await action.boundingBox();
			if ( ! box || box.y < inspectorBox.y - 1 || box.y + box.height > inspectorBox.y + inspectorBox.height + 1 ) {
				throw new Error( `submissions compact action is unreachable: ${ selector }` );
			}
			const hitId = await page.evaluate( ( point ) => document.elementFromPoint( point.x,point.y )?.closest( 'button' )?.id || '', { x:box.x + box.width / 2,y:box.y + box.height / 2 } );
			if ( hitId !== selector.slice( 1 ) ) {
				throw new Error( `submissions compact action is covered: ${ selector } hit ${ hitId || 'nothing' }` );
			}
		}
		return;
	}
	if ( viewport.name === 'mobile' ) {
		await page.locator( '#close-inspector' ).click();
		await page.waitForFunction( () => document.querySelector( '#submission-inspector' )?.getAttribute( 'aria-hidden' ) === 'true' );
		return;
	}
	await page.locator( '#approve-submission' ).click();
	await page.getByText( /is published/ ).waitFor();
	await page.locator( '#submission-inspector' ).waitFor( { state: 'attached' } );
	if ( viewport.width <= 780 ) {
		await page.waitForFunction( () => document.querySelector( '#submission-inspector' )?.getAttribute( 'aria-hidden' ) === 'true' );
	} else {
		await page.getByText( 'Choose a submission', { exact: true } ).waitFor();
	}
	await page.evaluate( () => document.querySelector( '.workspace' )?.scrollTo( 0, 0 ) );
}

async function exerciseCollections( page, viewport ) {
	await page.locator( '#newCollection' ).click();
	await page.locator( '#shelfName' ).fill( 'Smoke shelf' );
	await page.locator( '#shelfForm button.primary' ).click();
	await page.getByText( 'Smoke shelf', { exact: true } ).waitFor();
	await page.locator( '#newEntry' ).click();
	await page.locator( '#title' ).fill( 'Smoke collection item' );
	await page.locator( '#collection option' ).first().waitFor( { state: 'attached' } );
	await page.locator( '#collection' ).selectOption( { index: 0 } );
	await page.locator( '#form button.primary' ).click();
	await page.locator( '#dialog' ).waitFor( { state: 'hidden' } );
	await page.waitForTimeout( 200 );
	if ( await page.locator( '[data-edit]' ).count() < 1 ) {
		throw new Error( `collections did not persist and render a created item: ${ await page.locator( 'body' ).innerText() }` );
	}
	await page.locator( '#search' ).fill( 'Smoke collection' );
	await page.locator( '[data-edit]' ).first().waitFor();
	await page.locator( '#exportJson' ).click();
	await page.locator( '#exportCsv' ).click();
	if ( viewport.name === 'desktop' ) {
		await page.locator( '[data-delete]' ).first().click();
		await page.locator( '[data-delete]' ).first().waitFor( { state: 'detached' } );
	}
}

