function smokeRenderedContent( raw ) {
	return String( raw || '' ).replace( /<!--([\s\S]*?)-->/g, '' );
}

async function maybeServeWpApiStub( req, res, pathname, patterns ) {
	const collectionPath = '/wp-json/wp/v2/blocks';
	if ( pathname === collectionPath ) {
		if ( req.method === 'GET' ) {
			sendJson( res, 200, patterns, {
				'x-wp-total': String( patterns.length ),
				'x-wp-totalpages': '1',
			} );
			return true;
		}
		if ( req.method === 'POST' ) {
			let payload = {};
			try {
				payload = JSON.parse( await readRequestBody( req ) || '{}' );
			} catch ( _error ) {
				payload = {};
			}
			const id = patterns.reduce( ( highest, pattern ) => Math.max( highest, pattern.id ), 100 ) + 1;
			const now = new Date().toISOString().slice( 0, 19 );
			const created = {
				id,
				date: now,
				modified: now,
				status: payload.status || 'publish',
				title: { raw: String( payload.title || 'Untitled pattern' ), rendered: String( payload.title || 'Untitled pattern' ) },
				content: { raw: String( payload.content || '' ), rendered: smokeRenderedContent( payload.content ) },
			};
			patterns.unshift( created );
			sendJson( res, 201, created );
			return true;
		}
	}

	const itemMatch = pathname.match( /^\/wp-json\/wp\/v2\/blocks\/(\d+)$/ );
	if ( ! itemMatch ) {
		return false;
	}
	const id = Number( itemMatch[ 1 ] );
	const index = patterns.findIndex( ( pattern ) => pattern.id === id );
	if ( index < 0 ) {
		sendJson( res, 404, { code: 'rest_post_invalid_id', message: 'Invalid pattern ID.' } );
		return true;
	}
	if ( req.method === 'GET' ) {
		sendJson( res, 200, patterns[ index ] );
		return true;
	}
	if ( req.method === 'POST' ) {
		let payload = {};
		try {
			payload = JSON.parse( await readRequestBody( req ) || '{}' );
		} catch ( _error ) {
			payload = {};
		}
		const current = patterns[ index ];
		const next = {
			...current,
			modified: new Date().toISOString().slice( 0, 19 ),
			title: payload.title === undefined ? current.title : { raw: String( payload.title ), rendered: String( payload.title ) },
			content: payload.content === undefined ? current.content : { raw: String( payload.content ), rendered: smokeRenderedContent( payload.content ) },
		};
		patterns.splice( index, 1, next );
		sendJson( res, 200, next );
		return true;
	}
	if ( req.method === 'DELETE' ) {
		const [ previous ] = patterns.splice( index, 1 );
		sendJson( res, 200, { deleted: true, previous } );
		return true;
	}

	sendJson( res, 405, { code: 'rest_no_route', message: 'Unsupported smoke request.' } );
	return true;
}

async function maybeServeOddApiStub( req, res, pathname, appStore ) {
	const restPath = pathname.startsWith( '/wp-json/odd/v1/' )
		? pathname.slice( '/wp-json'.length )
		: pathname;
	if ( ! restPath.startsWith( '/odd/v1/' ) ) {
		return false;
	}

	const storeSegment = restPath.match( /^\/odd\/v1\/apps\/store\/([a-z0-9-]+)\/([A-Za-z0-9-]+)$/ );
	if ( storeSegment ) {
		const key = `${ storeSegment[ 1 ] }/${ storeSegment[ 2 ].toLowerCase() }`;
		if ( req.method === 'GET' ) {
			sendJson( res, 200, { value: appStore.has( key ) ? appStore.get( key ) : null } );
			return true;
		}
		if ( req.method === 'POST' || req.method === 'PUT' ) {
			let parsed = {};
			try {
				parsed = JSON.parse( await readRequestBody( req ) || '{}' );
			} catch ( _error ) {
				parsed = {};
			}
			const value = Object.prototype.hasOwnProperty.call( parsed, 'value' ) ? parsed.value : null;
			appStore.set( key, value );
			sendJson( res, 200, { value } );
			return true;
		}
		if ( req.method === 'DELETE' ) {
			appStore.delete( key );
			res.writeHead( 204 );
			res.end();
			return true;
		}
	}

	const storeKeys = restPath.match( /^\/odd\/v1\/apps\/store\/([a-z0-9-]+)$/ );
	if ( storeKeys ) {
		const slugPrefix = `${ storeKeys[ 1 ] }/`;
		if ( req.method === 'GET' ) {
			const keys = Array.from( appStore.keys() )
				.filter( ( key ) => key.startsWith( slugPrefix ) )
				.map( ( key ) => key.slice( slugPrefix.length ) )
				.sort();
			sendJson( res, 200, keys );
			return true;
		}
		if ( req.method === 'DELETE' ) {
			for ( const key of Array.from( appStore.keys() ) ) {
				if ( key.startsWith( slugPrefix ) ) {
					appStore.delete( key );
				}
			}
			res.writeHead( 204 );
			res.end();
			return true;
		}
	}

	sendJson( res, 404, { code: 'not_found', message: 'Smoke API stub has no route for this request.' } );
	return true;
}

function serveDirectory( root ) {
	const appStore = new Map();
	const wpPatterns = createWpPatternFixtures();
	const server = http.createServer( async ( req, res ) => {
		try {
			const url = new URL( req.url || '/', 'http://127.0.0.1' );
			let pathname = decodeURIComponent( url.pathname );
			if ( await maybeServeOddApiStub( req, res, pathname, appStore ) ) {
				return;
			}
			if ( await maybeServeWpApiStub( req, res, pathname, wpPatterns ) ) {
				return;
			}
			if ( pathname.endsWith( '/' ) ) {
				pathname += 'index.html';
			}
			const filePath = path.resolve( root, '.' + pathname );
			if ( ! filePath.startsWith( root + path.sep ) ) {
				res.writeHead( 403 );
				res.end( 'forbidden' );
				return;
			}
			const raw = await fsp.readFile( filePath );
			res.writeHead( 200, {
				'content-type': contentTypeFor( filePath ),
				'x-content-type-options': 'nosniff',
			} );
			res.end( raw );
		} catch ( error ) {
			res.writeHead( error && error.code === 'ENOENT' ? 404 : 500 );
			res.end( 'not found' );
		}
	} );

	return new Promise( ( resolve, reject ) => {
		server.on( 'error', reject );
		server.listen( 0, '127.0.0.1', () => {
			const address = server.address();
			resolve( {
				baseUrl: `http://127.0.0.1:${ address.port }`,
				close: () => new Promise( ( done ) => server.close( done ) ),
			} );
		} );
	} );
}

function runChecked( cmd, args, options = {} ) {
	const result = spawnSync( cmd, args, {
		cwd: REPO_ROOT,
		encoding: 'utf8',
		...options,
	} );
	if ( result.status !== 0 ) {
		throw new Error( [
			`${ cmd } ${ args.join( ' ' ) } failed with exit ${ result.status }`,
			result.stdout && result.stdout.trim(),
			result.stderr && result.stderr.trim(),
		].filter( Boolean ).join( '\n' ) );
	}
	return result;
}

function extractBundle( slug, tempRoot ) {
	const sourceDir = path.join( APPS_DIR, slug );
	const bundlePath = path.join( CATALOG_BUNDLES_DIR, `${ slug }.wp` );
	const extractDir = path.join( tempRoot, slug );
	if ( ! fs.existsSync( sourceDir ) ) {
		throw new Error( `${ slug }: missing app source directory` );
	}
	if ( ! fs.existsSync( bundlePath ) ) {
		throw new Error( `${ slug }: missing built catalog bundle` );
	}
	fs.mkdirSync( extractDir, { recursive: true } );
	runChecked( 'unzip', [ '-qq', bundlePath, '-d', extractDir ] );
	const manifestPath = path.join( extractDir, 'manifest.json' );
	if ( ! fs.existsSync( manifestPath ) ) {
		throw new Error( `${ slug }: bundle.wp did not contain manifest.json` );
	}
	runChecked( VALIDATE_MANIFEST, [ manifestPath ] );
	const manifest = JSON.parse( fs.readFileSync( manifestPath, 'utf8' ) );
	if ( manifest.type !== 'app' ) {
		throw new Error( `${ slug }: manifest type must be "app"` );
	}
	if ( manifest.slug !== slug ) {
		throw new Error( `${ slug }: manifest slug is "${ manifest.slug }"` );
	}
	const entry = manifest.entry || 'index.html';
	if ( ! fs.existsSync( path.join( extractDir, entry ) ) ) {
		throw new Error( `${ slug }: entry "${ entry }" missing from bundle.wp` );
	}
	return { slug, bundlePath, extractDir, manifest, entry };
}

async function exercisePantry( page, viewport ) {
	await page.locator( '#pattern-grid .pattern-card:not(.pattern-card--skeleton)' ).first().waitFor();
	await page.locator( '#pattern-grid .pattern-card:not(.pattern-card--skeleton)' ).first().click();
	const preview = page.locator( '#pattern-preview iframe' );
	await preview.waitFor();
	if ( await preview.getAttribute( 'sandbox' ) !== '' ) {
		throw new Error( 'pantry preview iframe is missing its empty sandbox policy' );
	}
	if ( await preview.getAttribute( 'referrerpolicy' ) !== 'no-referrer' ) {
		throw new Error( 'pantry preview iframe is missing its no-referrer policy' );
	}
	const srcdoc = await preview.getAttribute( 'srcdoc' ) || '';
	if ( ! srcdoc.includes( "default-src 'none'" ) ) {
		throw new Error( 'pantry preview iframe is missing its restrictive CSP' );
	}

	await page.locator( '#favorite-pattern' ).click();
	if ( viewport.name !== 'desktop' ) {
		await page.locator( '#close-inspector' ).click();
	}
	await page.locator( '#pattern-search' ).fill( 'announcement' );
	await page.locator( '#pattern-grid .pattern-card' ).first().waitFor();
	await page.locator( '#pattern-search' ).fill( '' );

	if ( viewport.name !== 'desktop' ) {
		return;
	}

	await page.locator( '#new-pattern' ).click();
	await page.locator( '#new-pattern-title' ).fill( 'Smoke shelf pattern' );
	await page.locator( '#create-submit' ).click();
	await page.getByText( 'Smoke shelf pattern', { exact: true } ).first().waitFor();
	await page.locator( '#rename-pattern' ).click();
	await page.locator( '#rename-input' ).fill( 'Smoke shelf pattern renamed' );
	await page.locator( '#title-editor [type="submit"]' ).click();
	await page.getByText( 'Smoke shelf pattern renamed', { exact: true } ).first().waitFor();
	await page.locator( '#duplicate-pattern' ).click();
	await page.getByText( 'Smoke shelf pattern renamed copy', { exact: true } ).first().waitFor();
	await page.locator( '#trash-pattern' ).click();
	await page.locator( '#trash-form [value="trash"]' ).click();
	await page.locator( '#pattern-grid .pattern-card h2', { hasText: 'Smoke shelf pattern renamed copy' } ).waitFor( { state: 'detached' } );
}

async function exerciseWorkbench( page, viewport ) {
	const rail = page.locator( '.tool-rail' );
	const expectedOrientation = viewport.width <= 560 ? 'horizontal' : 'vertical';
	if ( await rail.getAttribute( 'aria-orientation' ) !== expectedOrientation ) {
		throw new Error( `workbench tab orientation does not match ${ viewport.name } layout` );
	}
	const tabs = page.locator( '[role="tab"]' );
	for ( let index = 0; index < await tabs.count(); index++ ) {
		if ( ! await tabs.nth( index ).getAttribute( 'aria-label' ) ) {
			throw new Error( `workbench tab ${ index + 1 } has no accessible name` );
		}
	}
	await page.locator( '[data-tool="clean"]' ).focus();
	await page.keyboard.press( expectedOrientation === 'horizontal' ? 'ArrowRight' : 'ArrowDown' );
	if ( await page.locator( '[data-tool="markdown"]' ).getAttribute( 'aria-selected' ) !== 'true' ) {
		throw new Error( 'workbench did not move to the next tab on the layout axis' );
	}
	await page.locator( '#markdown-input' ).fill( '<img src=x onerror=alert(1)>\n[unsafe](javascript:alert(2))' );
	if ( await page.locator( '#markdown-preview img, #markdown-preview script, #markdown-preview svg' ).count() ) {
		throw new Error( 'workbench rendered hostile Markdown as active DOM' );
	}
}

async function exercisePage( page, app, viewport ) {
	await page.keyboard.press( 'Space' );
	await page.keyboard.press( 'ArrowLeft' );
	await page.keyboard.press( 'ArrowRight' );
	await page.keyboard.press( 'ArrowUp' );
	await page.keyboard.down( 'ArrowDown' );
	await page.waitForTimeout( 80 );
	await page.keyboard.up( 'ArrowDown' );
	await page.keyboard.press( 'KeyP' );
	await page.waitForTimeout( 80 );
	await page.keyboard.press( 'KeyP' );

	const buttons = await page.locator( '[data-action], #reset-button' ).elementHandles();
	for ( const button of buttons.slice( 0, 8 ) ) {
		try {
			await button.click( { timeout: 1000 } );
		} catch ( _error ) {
			// Hidden or covered buttons are not a smoke failure by themselves.
		}
	}
	await page.waitForTimeout( 250 );

	if ( app.slug === 'pantry' ) {
		await exercisePantry( page, viewport );
	} else if ( app.slug === 'workbench' ) {
		await exerciseWorkbench( page, viewport );
	}
}

async function inspectPage( page ) {
	return page.evaluate( () => {
		const canvas = document.querySelector( 'canvas' );
		let canvasInfo = null;
		if ( canvas ) {
			const box = canvas.getBoundingClientRect();
			const ctx = canvas.getContext( '2d' );
			const sample = ctx.getImageData( 0, 0, canvas.width, canvas.height ).data;
			let nonblank = 0;
			for ( let i = 0; i < sample.length; i += 64 ) {
				if ( sample[ i ] || sample[ i + 1 ] || sample[ i + 2 ] || sample[ i + 3 ] ) {
					nonblank++;
				}
			}
			canvasInfo = {
				width: canvas.width,
				height: canvas.height,
				cssWidth: Math.round( box.width ),
				cssHeight: Math.round( box.height ),
				nonblank,
			};
		}
		return {
			title: document.title,
			bodyTextLength: ( document.body.innerText || '' ).trim().length,
			canvas: canvasInfo,
			storageKeys: Object.keys( localStorage ).sort(),
			horizontalOverflow: Math.max( 0, document.documentElement.scrollWidth - window.innerWidth ),
		};
	} );
}

function assertPageMetrics( app, viewport, metrics, events ) {
	const problems = [];
	const externalRequests = events.requests.filter( ( url ) => {
		try {
			const parsed = new URL( url );
			return parsed.protocol === 'http:' || parsed.protocol === 'https:';
		} catch ( _error ) {
			return false;
		}
	} ).filter( ( url ) => ! url.startsWith( events.baseUrl + '/' ) );

	if ( events.pageErrors.length ) {
		problems.push( `page errors: ${ events.pageErrors.join( ' | ' ) }` );
	}
	if ( events.consoleErrors.length ) {
		problems.push( `console errors: ${ events.consoleErrors.join( ' | ' ) }` );
	}
	if ( events.httpErrors.length ) {
		problems.push( `HTTP errors: ${ events.httpErrors.join( ' | ' ) }` );
	}
	if ( events.requestFailures.length ) {
		problems.push( `failed requests: ${ events.requestFailures.join( ' | ' ) }` );
	}
	if ( externalRequests.length ) {
		problems.push( `external requests: ${ externalRequests.join( ' | ' ) }` );
	}
	if ( ! metrics.title ) {
		problems.push( 'document title is empty' );
	}
	if ( metrics.bodyTextLength < 8 ) {
		problems.push( 'body text is unexpectedly sparse' );
	}
	if ( metrics.horizontalOverflow > 2 ) {
		problems.push( `horizontal overflow ${ Math.ceil( metrics.horizontalOverflow ) }px` );
	}
	if ( metrics.canvas && metrics.canvas.nonblank < 64 ) {
		problems.push( `canvas appears blank (${ metrics.canvas.nonblank } nonblank samples)` );
	}
	const badStorage = metrics.storageKeys.filter( ( key ) => ! key.startsWith( `odd.${ app.slug }.` ) );
	if ( badStorage.length ) {
		problems.push( `localStorage keys are not app-namespaced: ${ badStorage.join( ', ' ) }` );
	}
	if ( problems.length ) {
		throw new Error( `${ app.slug }/${ viewport.name }: ${ problems.join( '; ' ) }` );
	}
}

async function smokeOneViewport( browser, server, app, viewport, screenshots, screenshotsDir ) {
	const context = await browser.newContext( {
		viewport: { width: viewport.width, height: viewport.height },
	} );
	const page = await context.newPage();
	const events = {
		baseUrl: server.baseUrl,
		consoleErrors: [],
		httpErrors: [],
		pageErrors: [],
		requestFailures: [],
		requests: [],
	};
	page.on( 'console', ( msg ) => {
		if ( msg.type() === 'error' ) {
			events.consoleErrors.push( msg.text() );
		}
	} );
	page.on( 'pageerror', ( error ) => events.pageErrors.push( error.message ) );
	page.on( 'request', ( request ) => events.requests.push( request.url() ) );
	page.on( 'response', ( response ) => {
		if ( response.status() >= 400 ) {
			events.httpErrors.push( `${ response.status() } ${ response.url() }` );
		}
	} );
	page.on( 'requestfailed', ( request ) => {
		events.requestFailures.push( `${ request.url() } ${ request.failure()?.errorText || '' }`.trim() );
	} );

	try {
		if ( app.slug === 'pantry' ) {
			await page.addInitScript( () => {
				const preferences = new Map();
				window.oddApp = {
					apiVersion: 1,
					slug: 'pantry',
					adminUrl: `${ window.location.origin }/wp-admin/`,
					request: async ( path, init = {} ) => {
						const url = new URL( String( path ).replace( /^\/+/, '' ), `${ window.location.origin }/wp-json/` );
						const headers = new Headers( init.headers || {} );
						headers.set( 'Accept', 'application/json' );
						let body = init.body;
						if ( body !== undefined && typeof body !== 'string' && ! ( body instanceof FormData ) ) {
							headers.set( 'Content-Type', 'application/json' );
							body = JSON.stringify( body );
						}
						const response = await fetch( url, { ...init, body, headers, credentials: 'same-origin' } );
						const value = response.status === 204 ? null : await response.json();
						if ( ! response.ok ) {
							const error = new Error( value?.message || `${ response.status } ${ response.statusText }` );
							error.status = response.status;
							error.code = value?.code || '';
							throw error;
						}
						if ( url.searchParams.get( '_envelope' ) === '1' ) {
							return {
								body: value,
								headers: Object.fromEntries( response.headers.entries() ),
								status: response.status,
							};
						}
						return value;
					},
					storage: {
						list: async () => [ ...preferences.keys() ].sort(),
						get: async ( segment ) => preferences.has( segment ) ? preferences.get( segment ) : null,
						set: async ( segment, value ) => {
							preferences.set( segment, value );
							return value;
						},
						remove: async ( segment ) => preferences.delete( segment ),
						clear: async () => preferences.clear(),
					},
				};
			} );
		}
		const entryUrl = `${ server.baseUrl }/${ app.slug }/${ app.entry }`;
		await page.goto( entryUrl, { waitUntil: 'load' } );
		await page.waitForTimeout( 350 );
		await exercisePage( page, app, viewport );
		const metrics = await inspectPage( page );
		assertPageMetrics( app, viewport, metrics, events );
		if ( screenshots ) {
			await fsp.mkdir( screenshotsDir, { recursive: true } );
			await page.screenshot( {
				path: path.join( screenshotsDir, `${ app.slug }-${ viewport.name }.png` ),
				fullPage: true,
			} );
		}
		const canvas = metrics.canvas ? `${ metrics.canvas.cssWidth }x${ metrics.canvas.cssHeight }, samples=${ metrics.canvas.nonblank }` : 'no canvas';
		return { app: app.slug, viewport: viewport.name, title: metrics.title, canvas };
	} finally {
		await context.close();
	}
}

async function run() {
	const args = parseArgs();
	const slugs = unique( args.slugs.length ? args.slugs : listBuiltAppSlugs() );
	if ( ! slugs.length ) {
		throw new Error( 'no app sources found' );
	}

	const tempRoot = await fsp.mkdtemp( path.join( os.tmpdir(), 'odd-app-smoke-' ) );
	let server = null;
	let browser = null;
	try {
		const apps = slugs.map( ( slug ) => extractBundle( slug, tempRoot ) );
		browser = await chromium.launch( { headless: ! args.headed } );

		console.log( `[smoke-catalog-apps] testing ${ apps.length } app bundle(s)` );
		const results = [];
		for ( const app of apps ) {
			for ( const viewport of VIEWPORTS ) {
				// Each page load receives pristine WordPress/App API fixtures.
				// Mutating one app or viewport must not drain the next one's queue.
				server = await serveDirectory( tempRoot );
				let result;
				try {
					result = await smokeOneViewport(
						browser,
						server,
						app,
						viewport,
						args.screenshots,
						args.screenshotsDir
					);
				} finally {
					await server.close();
					server = null;
				}
				results.push( result );
				console.log( `  ok ${ result.app }/${ result.viewport } — ${ result.title } (${ result.canvas })` );
			}
		}
		if ( args.screenshots ) {
			console.log( `[smoke-catalog-apps] screenshots: ${ path.relative( REPO_ROOT, args.screenshotsDir ) }` );
		}
		console.log( `[smoke-catalog-apps] ok: ${ results.length } page loads` );
	} finally {
		if ( browser ) {
			await browser.close();
		}
		if ( server ) {
			await server.close();
		}
		await fsp.rm( tempRoot, { recursive: true, force: true } );
	}
}

run().catch( ( error ) => {
	console.error( `[smoke-catalog-apps] FAIL: ${ error && error.stack || error }` );
	process.exit( 1 );
} );
