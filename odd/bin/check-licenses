#!/usr/bin/env python3
"""Check the small, explicit set of third-party and generated assets."""
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[2]
LICENSES = ROOT / "LICENSES.md"
EXPECTED_PLUGIN_ASSETS = {"odd-browser-api.js", "odd-eye.svg"}
NOTES_SNAPSHOT = (
    ROOT
    / "_tools/catalog-sources/apps/odd-notes/component-snapshot"
    / "openstation-ui-components.min.js"
)


def main() -> int:
    text = LICENSES.read_text(encoding="utf-8")
    actual = {
        path.name
        for path in (ROOT / "odd/assets").iterdir()
        if path.is_file() and not path.name.startswith(".")
    }
    problems = []
    if actual != EXPECTED_PLUGIN_ASSETS:
        problems.append(
            f"odd/assets must contain exactly {sorted(EXPECTED_PLUGIN_ASSETS)}; "
            f"found {sorted(actual)}"
        )
    if not NOTES_SNAPSHOT.is_file():
        problems.append("ODD Notes OpenStation component snapshot is missing")
    elif "GPL-2.0-or-later" not in NOTES_SNAPSHOT.read_text(encoding="utf-8")[:240]:
        problems.append("ODD Notes OpenStation component snapshot lacks its license banner")
    for phrase in ("GPLv2-or-later", "OpenStation", "WordPress/openstation"):
        if phrase not in text:
            problems.append(f"LICENSES.md is missing {phrase!r}")
    if problems:
        for problem in problems:
            print(f"error: {problem}", file=sys.stderr)
        return 1
    print("license inventory ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
