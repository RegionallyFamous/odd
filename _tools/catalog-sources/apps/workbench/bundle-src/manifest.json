{
  "$schema": "https://raw.githubusercontent.com/RegionallyFamous/odd/main/docs/schemas/manifest.schema.json",
  "type": "app",
  "slug": "workbench",
  "name": "ODD Workbench",
  "version": "1.0.1",
  "author": "Regionally Famous",
  "description": "A fast local utility desk for text, Markdown, slugs, JSON, diffs, and everyday conversions.",
  "icon": "icon.webp",
  "entry": "index.html",
  "capability": "manage_options",
  "window": {
    "width": 900,
    "height": 620,
    "minWidth": 360,
    "minHeight": 480,
    "resizable": true
  },
  "surfaces": {
    "desktop": true,
    "taskbar": false
  },
  "extensions": {
    "commands": [
      {
        "slug": "open-workbench",
        "label": "Open ODD Workbench",
        "run": "odd.apps.open:workbench"
      }
    ],
    "muses": [
      {
        "slug": "workbench",
        "voice": {
          "appOpen": {
            "workbench": [
              "Tools out. Mess in."
            ]
          }
        }
      }
    ]
  }
}
