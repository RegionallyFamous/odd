# Build output
dist/
node_modules/
vendor/
__pycache__/
*.pyc

# OS / editor / lint caches
.DS_Store
.phpcs-cache
.phpunit.result.cache
*.swp

# Local e2e WordPress tree (bin/e2e-local.sh)
.e2e/

# Local catalog preview artifacts (odd/bin/build-catalog-preview)
.odd/
/catalog-preview/
/site/catalog-preview/

# Playwright output (never commit ephemeral reports)
/playwright-report/
/test-results/

# Hosted Playground zips should come from WordPress.org or release artifacts,
# not checked-in snapshots.
site/downloads/*.zip
site/vendor/*.zip
